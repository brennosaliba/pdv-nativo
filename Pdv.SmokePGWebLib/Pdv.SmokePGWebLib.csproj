<Project Sdk="Microsoft.NET.Sdk">
  <!-- Harness de fumaça da PGWebLib.dll de verdade (PayGo Windows), em 32 bits.
       Não faz venda. Não entra no instalador nem na bateria. A única PGWebLib.dll da
       máquina de homologação é x86, e não há runtime .NET x86 instalado: por isso é
       autocontido win-x86 (dotnet build já deixa o exe pronto em bin/). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>Pdv.SmokePGWebLib</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pdv.Nucleo\Pdv.Nucleo.csproj" />
  </ItemGroup>
</Project>
