<Window x:Class="Pdv.Instalador.JanelaInstalador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar o PDV" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F7F2E9">
    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="PDV American Day" FontSize="26" FontWeight="Bold" Foreground="#16212B"/>
        <TextBlock x:Name="TxtVersao" FontSize="13" Foreground="#4A5661" Margin="0,4,0,16"/>

        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#16212B" Margin="0,0,0,16"
                   Text="Instala (ou atualiza) a frente de caixa nesta máquina. Atualizar por cima NUNCA apaga as vendas nem a configuração da loja — só troca o programa."/>

        <CheckBox x:Name="ChkIniciar" Content="Iniciar com o Windows (recomendado para o caixa da loja)"
                  IsChecked="True" FontSize="14" Margin="0,0,0,8"/>
        <CheckBox x:Name="ChkAtalho" Content="Atalho na área de trabalho"
                  IsChecked="True" FontSize="14" Margin="0,0,0,16"/>

        <TextBlock x:Name="TxtProgresso" FontSize="13" Foreground="#006A84" Margin="0,0,0,12" Text=" "/>

        <Button x:Name="BtnInstalar" Content="Instalar" Click="Instalar" FontSize="17"
                FontWeight="Bold" MinHeight="52" Background="#D6296B" Foreground="White"
                BorderThickness="0" Cursor="Hand"/>
        <TextBlock x:Name="TxtErro" TextWrapping="Wrap" FontSize="13" Foreground="#B3251C" Margin="0,10,0,0"/>
    </StackPanel>
</Window>
