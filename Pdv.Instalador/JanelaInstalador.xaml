<Window x:Class="Pdv.Instalador.JanelaInstalador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar o PDV" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F6F8" FontFamily="Segoe UI">
    <!-- PALETA NEUTRA DE PROPOSITO. O instalador e a primeira coisa que a maquina de
         uma loja QUALQUER ve — nao da para ele chegar pintado com a marca de um
         cliente. O rosa e o creme daqui eram da American Day. O nome e as cores da
         LOJA aparecem depois, na tela do caixa, e vem da configuracao dela. -->
    <Window.Resources>
        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#16212B"/>
        </Style>
        <Style x:Key="Corpo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3B4652"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="Passo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F6F8C"/>
        </Style>
        <!-- Botao principal com estilo proprio: sem isto o botao do Windows some no
             meio da tela clara e ninguem acha onde clicar. -->
        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0F6F8C"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="#0C5A73"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fundo" Property="Background" Value="#B7BEC6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotaoDiscreto" TargetType="Button" BasedOn="{StaticResource BotaoPrincipal}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F6F8C"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="42"/>
        </Style>
        <Style TargetType="CheckBox">
            <!-- CheckBox sem Style pinta o texto de preto fixo; aqui o fundo e claro,
                 mas deixo explicito para nao repetir o problema que ja aconteceu no
                 tema escuro do PDV. -->
            <Setter Property="Foreground" Value="#16212B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="32,26,32,26">
        <TextBlock x:Name="TxtPasso" Style="{StaticResource Passo}" Text=" "/>
        <TextBlock x:Name="TxtTitulo" Style="{StaticResource Titulo}" Margin="0,4,0,2"/>
        <TextBlock x:Name="TxtVersao" FontSize="12" Foreground="#6B7681" Margin="0,0,0,18"/>

        <!-- ============================ 1. BOAS-VINDAS ============================ -->
        <StackPanel x:Name="PainelInicio">
            <TextBlock x:Name="TxtIntro" Style="{StaticResource Corpo}" Margin="0,0,0,16"/>

            <Border Background="#FFFFFF" CornerRadius="8" Padding="18,14" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource Corpo}" Margin="0,0,0,8"
                               Text="1.  Instala a frente de caixa nesta máquina."/>
                    <TextBlock x:Name="TxtItemPayGo" Style="{StaticResource Corpo}" Margin="0,0,0,8"
                               Text="2.  Instala o PayGo, que é quem fala com a maquininha."/>
                    <TextBlock Style="{StaticResource Corpo}"
                               Text="3.  Abre a configuração da loja, passo a passo: dados da loja, nota fiscal, impressora e maquininha."/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="ChkIniciar" IsChecked="True"
                      Content="Ligar o caixa junto com o Windows (é o que a loja quer)"/>
            <CheckBox x:Name="ChkAtalho" IsChecked="True"
                      Content="Deixar um atalho na área de trabalho"/>
        </StackPanel>

        <!-- ============================ 2. TRABALHANDO ============================ -->
        <StackPanel x:Name="PainelProgresso" Visibility="Collapsed">
            <TextBlock x:Name="TxtProgresso" Style="{StaticResource Corpo}"
                       Foreground="#0F6F8C" FontSize="15" Margin="0,0,0,14"/>
            <ProgressBar x:Name="Barra" Height="6" IsIndeterminate="True"
                         Foreground="#0F6F8C" Background="#E3E7EB" BorderThickness="0"
                         Margin="0,0,0,18"/>
            <TextBlock Style="{StaticResource Corpo}" FontSize="13" Foreground="#6B7681"
                       Text="Não feche esta janela. As vendas e a configuração que já existirem nesta máquina não são tocadas."/>
        </StackPanel>

        <!-- ============================== 3. PRONTO =============================== -->
        <StackPanel x:Name="PainelFim" Visibility="Collapsed">
            <TextBlock x:Name="TxtResumo" Style="{StaticResource Corpo}" FontSize="15" Margin="0,0,0,16"/>
            <Border x:Name="CaixaAviso" Background="#FFF6E0" CornerRadius="8" Padding="16,12"
                    Margin="0,0,0,16" Visibility="Collapsed">
                <TextBlock x:Name="TxtAviso" Style="{StaticResource Corpo}" Foreground="#7A5A10"/>
            </Border>
            <Button x:Name="BtnPayGoVisivel" Style="{StaticResource BotaoDiscreto}"
                    Content="Instalar o PayGo na tela" Click="InstalarPayGoVisivel"
                    Visibility="Collapsed" Margin="0,0,0,14"/>
        </StackPanel>

        <!-- =============================== RODAPÉ ================================ -->
        <Button x:Name="BtnPrincipal" Style="{StaticResource BotaoPrincipal}"
                Content="Instalar" Click="Avancar" Margin="0,4,0,0"/>
        <TextBlock x:Name="TxtErro" Style="{StaticResource Corpo}" Foreground="#B3251C"
                   Margin="0,12,0,0" Visibility="Collapsed"/>
    </StackPanel>
</Window>
