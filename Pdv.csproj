<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pdv</AssemblyName>
    <AssemblyTitle>MMFood - Frente de Caixa</AssemblyTitle>
    <Version>1.0.11</Version>
    <!-- Nome e empresa do Certificado de Conformidade PayGo (SETIS, 25/08/2026).
         Tem que bater com o 735-000 do protocolo e com o User-Agent do ControlPay. -->
    <Product>MMFood</Product>
    <Company>MMTech</Company>
    <!-- Icone do exe (conceito "mm" grafite aprovado 04/09). Sem ele o atalho fica
         generico ("cara de virus"). Gerado pelo modo gerar-icone do Pdv.Testes. -->
    <ApplicationIcon>Recursos\mmtech.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite direto + Dapper: no caminho da venda o comportamento precisa ser
         previsível. EF Core traz change-tracker e materialização que atrapalham mais
         do que ajudam num modelo append-only de dinheiro. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- QR do cupom da NFC-e. MIT, sem dependência nativa; o XamlQRCode devolve um
         DrawingBrush do WPF, então não puxa System.Drawing.Common junto. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Pdv.Nucleo\Pdv.Nucleo.csproj" />
  </ItemGroup>

  <!-- Os subprojetos ficam DENTRO desta pasta, e o SDK varre tudo por padrão —
       sem isso ele tenta compilar os fontes (e os obj/) deles junto, dando erro de
       atributo duplicado. -->
  <ItemGroup>
    <Compile Remove="Pdv.Nucleo\**;Pdv.Testes\**;Pdv.Instalador\**;Pdv.SmokePGWebLib\**" />
    <Page Remove="Pdv.Nucleo\**;Pdv.Testes\**;Pdv.Instalador\**;Pdv.SmokePGWebLib\**" />
    <None Remove="Pdv.Nucleo\**;Pdv.Testes\**;Pdv.Instalador\**;Pdv.SmokePGWebLib\**" />
    <EmbeddedResource Remove="Pdv.Nucleo\**;Pdv.Testes\**;Pdv.Instalador\**;Pdv.SmokePGWebLib\**" />
    <ApplicationDefinition Remove="Pdv.Nucleo\**;Pdv.Testes\**;Pdv.Instalador\**;Pdv.SmokePGWebLib\**" />
  </ItemGroup>

  <!-- A biblioteca da PayGo (PGWebLib.dll 4.1.50.24, homologada em 11/09/2026 como MMFood 1.0.0)
       viaja ao lado do exe, na pasta pgweb. Fica fora do arquivo unico de proposito: e uma
       DLL nativa carregada por caminho (PGWebLibNativa.UsarPasta / ConfigPGWebLib.PastaDll).
       Com ela dentro do caixa, a loja nao instala mais o PayGo Windows. -->
  <!-- O aviso do WhatsApp no caixa (11/09/2026): um toque curto gerado por nos
       (Recursos\sons\whatsapp.wav). A loja pode trocar deixando um whatsapp.wav em
       C:\ProgramData\PdvNativo\sons; ver Alerta.MensagemWhatsApp. -->
  <ItemGroup>
    <EmbeddedResource Include="Recursos\sons\whatsapp.wav" LogicalName="Pdv.sons.whatsapp.wav" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Recursos\pgweb\PGWebLib.dll" Link="pgweb\PGWebLib.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
