<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- TEMA CLARO (diurno) — para balcão sob luz forte de vitrine.
         Base creme da marca, não branco puro: papel de parede branco estoura
         ao lado da luz natural e cansa tanto quanto o escuro à noite.

         Todo par texto/fundo daqui foi medido (WCAG 2.1): CorTexto ≥ 12:1 sobre
         as três superfícies; CorTextoFraco ≥ 5,5:1; cores de estado ≥ 4,5:1.
         O teste de contraste em Pdv.Testes lê ESTE arquivo por regex — mudar um
         hex aqui sem recalcular derruba a bateria, e é exatamente essa a ideia.

         REGRA DE MANUTENÇÃO: mesmo conjunto de x:Key de Escuro.xaml, sempre. -->

    <Color x:Key="CorFundo">#EDE7DC</Color>
    <Color x:Key="CorPainel">#FBF8F2</Color>
    <Color x:Key="CorPainelAlto">#E6DCCC</Color>
    <Color x:Key="CorBorda">#7C7060</Color>
    <Color x:Key="CorTexto">#16212B</Color>
    <Color x:Key="CorTextoFraco">#4A5661</Color>
    <Color x:Key="CorRosa">#D6296B</Color>
    <Color x:Key="CorRosaEscuro">#A81E54</Color>
    <Color x:Key="CorCiano">#006A84</Color>
    <Color x:Key="CorAmarelo">#7A5B00</Color>
    <Color x:Key="CorMarca">#006A84</Color>
    <Color x:Key="CorOk">#1F6B3E</Color>
    <Color x:Key="CorErro">#B3251C</Color>
    <Color x:Key="CorRoxo">#6B3FA8</Color>

    <SolidColorBrush x:Key="Fundo" Color="{StaticResource CorFundo}"/>
    <SolidColorBrush x:Key="Painel" Color="{StaticResource CorPainel}"/>
    <SolidColorBrush x:Key="PainelAlto" Color="{StaticResource CorPainelAlto}"/>
    <SolidColorBrush x:Key="Borda" Color="{StaticResource CorBorda}"/>
    <SolidColorBrush x:Key="Texto" Color="{StaticResource CorTexto}"/>
    <SolidColorBrush x:Key="TextoFraco" Color="{StaticResource CorTextoFraco}"/>
    <SolidColorBrush x:Key="Rosa" Color="{StaticResource CorRosa}"/>
    <SolidColorBrush x:Key="RosaEscuro" Color="{StaticResource CorRosaEscuro}"/>
    <SolidColorBrush x:Key="Ciano" Color="{StaticResource CorCiano}"/>
    <SolidColorBrush x:Key="Amarelo" Color="{StaticResource CorAmarelo}"/>
    <SolidColorBrush x:Key="Marca" Color="{StaticResource CorMarca}"/>
    <SolidColorBrush x:Key="Ok" Color="{StaticResource CorOk}"/>
    <SolidColorBrush x:Key="Erro" Color="{StaticResource CorErro}"/>
    <SolidColorBrush x:Key="Roxo" Color="{StaticResource CorRoxo}"/>

    <SolidColorBrush x:Key="FundoAfundado" Color="#E8E1D5"/>

    <!-- No claro os chips são cor SÓLIDA: os translúcidos do escuro lavam sobre
         fundo claro e o chip desaparece. Texto do chip usa a cor de estado
         correspondente (Ok/Amarelo/Ciano), todas medidas ≥ 4,5:1 aqui. -->
    <SolidColorBrush x:Key="ChipOkFundo" Color="#DCEFE1"/>
    <SolidColorBrush x:Key="ChipOkBorda" Color="#3F8C5E"/>
    <SolidColorBrush x:Key="ChipAlertaFundo" Color="#FFF0AE"/>
    <SolidColorBrush x:Key="ChipAlertaBorda" Color="#A8811A"/>
    <SolidColorBrush x:Key="ChipInfoFundo" Color="#D8EDF4"/>
    <SolidColorBrush x:Key="ChipInfoBorda" Color="#2C8AA5"/>
    <SolidColorBrush x:Key="ChipErroFundo" Color="#F5DAD7"/>
    <SolidColorBrush x:Key="ChipErroBorda" Color="#B3251C"/>
    <SolidColorBrush x:Key="AvisoFundo" Color="#FCEBBE"/>
    <SolidColorBrush x:Key="AvisoBorda" Color="#A8811A"/>

    <!-- Invertido de propósito: elevação no claro é sombra (preto translúcido),
         não luz. -->
    <SolidColorBrush x:Key="VeuElevado" Color="#1416212B"/>
    <SolidColorBrush x:Key="CianoFraco" Color="#2C8AA5"/>

    <SolidColorBrush x:Key="SobreMarca" Color="#FFFFFF"/>

    <LinearGradientBrush x:Key="PainelDegrade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F0EAE0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarraDegrade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7F2E9" Offset="0"/>
        <GradientStop Color="#EBE4D8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RosaDegrade" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D6296B" Offset="0"/>
        <GradientStop Color="#A81E54" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AvatarDegrade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00ABD5" Offset="0"/>
        <GradientStop Color="#0086AA" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glow quase desligado no claro: neon sobre creme parece defeito de tela. -->
    <DropShadowEffect x:Key="GlowRosa" Color="#D6296B" BlurRadius="26" ShadowDepth="0" Opacity="0.15"/>

    <sys:Double x:Key="GlowOpacidade">0.15</sys:Double>
    <sys:Double x:Key="GlowCategoriaOpacidade">0.0</sys:Double>
    <sys:Double x:Key="SombraDialogoOpacidade">0.25</sys:Double>
    <sys:Double x:Key="FatorDegradeClaro">0.95</sys:Double>
    <sys:Double x:Key="FatorDegradeEscuro">0.65</sys:Double>
    <!-- Véus SUAVES de propósito: texto grafite sobre véu colorido forte
         ficava lamacento (reclamação real do dono). A cor marca a categoria
         pela BORDA e por um fundo leve; quem carrega a leitura é o texto. -->
    <sys:Byte x:Key="AlfaCatAtivaTopo">96</sys:Byte>
    <sys:Byte x:Key="AlfaCatAtivaBase">40</sys:Byte>
    <sys:Byte x:Key="AlfaCatInativaTopo">36</sys:Byte>
    <sys:Byte x:Key="AlfaCatInativaBase">14</sys:Byte>
    <sys:Byte x:Key="AlfaCatBordaAtiva">255</sys:Byte>
    <sys:Byte x:Key="AlfaCatBordaInativa">102</sys:Byte>

    <sys:Byte x:Key="AlfaChipFundo">48</sys:Byte>
    <sys:Byte x:Key="AlfaChipBorda">170</sys:Byte>
    <sys:Byte x:Key="AlfaFormaTopo">90</sys:Byte>
    <sys:Byte x:Key="AlfaFormaBase">40</sys:Byte>
    <sys:Byte x:Key="AlfaFormaBorda">153</sys:Byte>

</ResourceDictionary>
