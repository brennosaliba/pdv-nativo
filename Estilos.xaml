<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- SÓ ESTILOS. A paleta mora em Temas/Escuro.xaml e Temas/Claro.xaml —
         App.xaml carrega o tema como MergedDictionaries[0] e este arquivo como
         [1]; a troca de tema em runtime substitui o [0] e este fica parado.

         Por isso todo brush aqui é DynamicResource (resolve de novo quando o
         dicionário troca) e todo Style/Template segue StaticResource (estilos
         não mudam com o tema). -->

    <!-- Alvo de toque: 64px é o mínimo confortável pra dedo em pé, com pressa.
         Botão pequeno em PDV gera toque errado, e toque errado em caixa é dinheiro. -->
    <Style x:Key="BotaoBase" TargetType="Button">
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Background" Value="{DynamicResource Painel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="14" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- feedback imediato ao toque: sem isso o operador toca 2x -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.65"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <!-- 0.55 e não 0.35: desabilitado precisa parecer desabilitado, mas
                             com 0.35 o botão principal some da tela e o caixa fica sem foco. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoTecla" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="MinHeight" Value="76"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <!-- Ação principal em rosa: é a cor #1 da marca no digital, e ela não aparece
         em nenhum outro lugar da tela — o olho acha "finalizar" sem procurar.
         O glow é recurso do tema (GlowRosa): Color de Freezable não aceita
         referência dinâmica, então o efeito INTEIRO troca com o tema. -->
    <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{DynamicResource RosaDegrade}"/>
        <Setter Property="Foreground" Value="{DynamicResource SobreMarca}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Effect" Value="{DynamicResource GlowRosa}"/>
    </Style>

    <!-- Botão de barra (topo/rodapé): mesmo alvo de toque, altura menor. -->
    <Style x:Key="BotaoBarra" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextoFraco}"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- Campo de texto arredondado, com dica em cinza vinda do Tag. Sem a dica o
         operador novo não sabe que dá pra bipar o código de barras ali. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Painel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Marca}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Marca}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="12" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                            <TextBlock x:Name="dica" Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextoFraco}" IsHitTestVisible="False"
                                       FontSize="{TemplateBinding FontSize}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="dica" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Marca}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- CHECKBOX: sem estilo, o WPF pinta o texto de PRETO fixo — no tema escuro
         a legenda simplesmente sumia (o dono nao conseguia ler a opcao da comanda
         da cozinha). Herdar a cor do tema resolve, e de quebra o alvo fica maior
         para o dedo. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Background" Value="{DynamicResource Painel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
        <Setter Property="Padding" Value="9,0,0,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                        <Border x:Name="caixa" Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5">
                            <Path x:Name="tique" Data="M0,4 L3.5,7.5 L9,1" Stroke="White" StrokeThickness="2"
                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="caixa" Property="Background" Value="{DynamicResource Marca}"/>
                            <Setter TargetName="caixa" Property="BorderBrush" Value="{DynamicResource Marca}"/>
                            <Setter TargetName="tique" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="caixa" Property="BorderBrush" Value="{DynamicResource Marca}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- OPÇÃO EM CARTÃO: escolha exclusiva sem dropdown. Tudo visível de uma vez,
         alvo grande para o dedo, e o escolhido se anuncia pela cor da marca —
         numa tela de balcão isso vale mais que economizar espaço. -->
    <Style x:Key="BotaoOpcao" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="12" Padding="14,11" MinHeight="58"
                            Background="{DynamicResource Painel}"
                            BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Marca}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Marca}"/>
                            <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Fundo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- COMBOBOX: sem template próprio o WPF desenha o chrome cinza do sistema, que
         no meio das telas escuras parece caixa de diálogo antiga. Mesma linguagem do
         TextBox acima: painel, borda hairline, canto 12, marca no foco. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Painel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="alvo" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" CornerRadius="12" Background="{DynamicResource Painel}"
                                            BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"/>
                                            <Path Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center"
                                                  Data="M0,0 L10,0 L5,6 Z" Fill="{DynamicResource TextoFraco}"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Marca}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="texto" IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Painel}" BorderBrush="{DynamicResource Borda}"
                                    BorderThickness="1" CornerRadius="12" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="alvo" Property="BorderBrush" Value="{DynamicResource Marca}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="8" Margin="4,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Fundo}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Fundo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TOQUE: o WPF já sabe rolar com o dedo (panning), mas vem DESLIGADO.
         VerticalFirst = dedo pra cima/baixo rola; se o conteúdo for mais largo
         que a tela, pro lado também. Vale pra todo ScrollViewer do app —
         categorias, produtos, quadro do KDS, configuração. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalFirst"/>
        <Setter Property="PanningDeceleration" Value="0.003"/>
        <Setter Property="PanningRatio" Value="1"/>
    </Style>

    <!-- ScrollBar moderna: o padrão do WPF é a barra cinza 3D dos anos 90
         ("parece Windows 3.11" — o dono). Aqui: trilho invisível, polegar fino
         e arredondado na cor do tema, sem setinhas. Em tela touch a barra é
         INDICADOR, não controle — o dedo arrasta o conteúdo; 10px basta. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="polegar" CornerRadius="5" Margin="2,1"
                                                    Background="{DynamicResource TextoFraco}" Opacity="0.35"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="polegar" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="polegar" Property="Opacity" Value="0.85"/>
                                                    <Setter TargetName="polegar" Property="Background"
                                                            Value="{DynamicResource Marca}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="polegar" CornerRadius="5" Margin="1,2"
                                                            Background="{DynamicResource TextoFraco}" Opacity="0.35"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="polegar" Property="Opacity" Value="0.7"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="polegar" Property="Opacity" Value="0.85"/>
                                                            <Setter TargetName="polegar" Property="Background"
                                                                    Value="{DynamicResource Marca}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
