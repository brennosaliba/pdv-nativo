<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta: fundo escuro no caixa reduz cansaço em turno de 8h e faz o valor
         em destaque saltar.

         As cores de marca são as do BRAND.md (variantes digitais, que é o que o
         cliente já vê no site): rosa #F276A5 = ação, ciano #00ABD5 = acento.
         O teal do selo (#45A5AE) fica de fora de propósito — o manual proíbe
         ele lado a lado com o ciano, parece erro de cor. -->
    <Color x:Key="CorFundo">#0C1216</Color>
    <Color x:Key="CorPainel">#18232B</Color>
    <Color x:Key="CorPainelAlto">#22303A</Color>
    <Color x:Key="CorBorda">#2B3A44</Color>
    <Color x:Key="CorTexto">#ECEFF1</Color>
    <Color x:Key="CorTextoFraco">#8296A2</Color>
    <Color x:Key="CorRosa">#F276A5</Color>
    <Color x:Key="CorRosaEscuro">#D44685</Color>
    <Color x:Key="CorCiano">#00ABD5</Color>
    <Color x:Key="CorAmarelo">#FFE23E</Color>
    <Color x:Key="CorMarca">#00ABD5</Color>
    <Color x:Key="CorOk">#2E9E5B</Color>
    <Color x:Key="CorErro">#D2544C</Color>

    <SolidColorBrush x:Key="Fundo" Color="{StaticResource CorFundo}"/>
    <SolidColorBrush x:Key="Painel" Color="{StaticResource CorPainel}"/>
    <SolidColorBrush x:Key="PainelAlto" Color="{StaticResource CorPainelAlto}"/>
    <SolidColorBrush x:Key="Borda" Color="{StaticResource CorBorda}"/>
    <SolidColorBrush x:Key="Texto" Color="{StaticResource CorTexto}"/>
    <SolidColorBrush x:Key="TextoFraco" Color="{StaticResource CorTextoFraco}"/>
    <SolidColorBrush x:Key="Rosa" Color="{StaticResource CorRosa}"/>
    <SolidColorBrush x:Key="RosaEscuro" Color="{StaticResource CorRosaEscuro}"/>
    <SolidColorBrush x:Key="Ciano" Color="{StaticResource CorCiano}"/>
    <SolidColorBrush x:Key="Amarelo" Color="{StaticResource CorAmarelo}"/>
    <SolidColorBrush x:Key="Marca" Color="{StaticResource CorMarca}"/>
    <SolidColorBrush x:Key="Ok" Color="{StaticResource CorOk}"/>
    <SolidColorBrush x:Key="Erro" Color="{StaticResource CorErro}"/>

    <!-- Superfícies com gradiente sutil. Painel chapado num fundo escuro some: o
         cartão vira um retângulo sem relevo e a tela toda parece uma mancha só.
         O degradê de cima pra baixo é o que devolve a leitura de "isto é um objeto". -->
    <LinearGradientBrush x:Key="PainelDegrade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#22303A" Offset="0"/>
        <GradientStop Color="#141D24" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarraDegrade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B2731" Offset="0"/>
        <GradientStop Color="#131C23" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RosaDegrade" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F98BB4" Offset="0"/>
        <GradientStop Color="#E2578F" Offset="1"/>
    </LinearGradientBrush>

    <!-- Alvo de toque: 64px é o mínimo confortável pra dedo em pé, com pressa.
         Botão pequeno em PDV gera toque errado, e toque errado em caixa é dinheiro. -->
    <Style x:Key="BotaoBase" TargetType="Button">
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Background" Value="{StaticResource Painel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="14" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- feedback imediato ao toque: sem isso o operador toca 2x -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.65"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <!-- 0.55 e não 0.35: desabilitado precisa parecer desabilitado, mas
                             com 0.35 o botão principal some da tela e o caixa fica sem foco. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoTecla" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="MinHeight" Value="76"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <!-- Ação principal em rosa: é a cor #1 da marca no digital, e ela não aparece
         em nenhum outro lugar da tela — o olho acha "finalizar" sem procurar. -->
    <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{StaticResource RosaDegrade}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#F276A5" BlurRadius="26" ShadowDepth="0" Opacity="0.5"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão de barra (topo/rodapé): mesmo alvo de toque, altura menor. -->
    <Style x:Key="BotaoBarra" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- Campo de texto arredondado, com dica em cinza vinda do Tag. Sem a dica o
         operador novo não sabe que dá pra bipar o código de barras ali. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Painel}"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="CaretBrush" Value="{StaticResource Marca}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Marca}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="12" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                            <TextBlock x:Name="dica" Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextoFraco}" IsHitTestVisible="False"
                                       FontSize="{TemplateBinding FontSize}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="dica" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Marca}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
