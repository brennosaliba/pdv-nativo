<UserControl x:Class="Pdv.Telas.Kds"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- KDS de quiosque: o MESMO monitor touch do caixa vira a tela de preparo.
         Um toque no card assume o pedido, o segundo libera. Alvo grande, texto
         grande — quem olha está com a mão na massa, literalmente. -->
    <Grid Background="{DynamicResource Fundo}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BarraDegrade}" Padding="20,12"
                BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍩" FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="PEDIDOS" Foreground="{DynamicResource Texto}" FontSize="20"
                               FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border x:Name="ChipContagem" CornerRadius="11" Padding="10,3,12,4" Margin="14,0,0,0"
                            Background="{DynamicResource ChipInfoFundo}" BorderBrush="{DynamicResource ChipInfoBorda}"
                            BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtContagem" Text="0 na fila" Foreground="{DynamicResource Ciano}"
                                   FontSize="12" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="Atualizar" Style="{StaticResource BotaoBarra}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtIconeAtualiza" Text="⟳" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Atualizar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Voltar" Style="{StaticResource BotaoBarra}" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontSize="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Voltar ao caixa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14">
            <Grid>
                <WrapPanel x:Name="PainelCards"/>
                <StackPanel x:Name="PainelVazio" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,120,0,0" Visibility="Collapsed">
                    <TextBlock Text="🛎" FontSize="52" HorizontalAlignment="Center" Opacity="0.45"/>
                    <TextBlock Text="Sem pedidos na fila" Foreground="{DynamicResource TextoFraco}"
                               FontSize="20" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Venda no balcão e pedido do delivery aparecem aqui sozinhos."
                               Foreground="{DynamicResource TextoFraco}" FontSize="13" Margin="0,6,0,0"
                               HorizontalAlignment="Center" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
