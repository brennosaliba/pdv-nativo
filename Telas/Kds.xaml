<UserControl x:Class="Pdv.Telas.Kds"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <!-- KDS em QUADRO, espelhando o fluxo do KDS da Savassi
         (NEW → IN_PRODUCTION → READY → CONCLUDED):

           NA FILA   →   FAZENDO   →   PRONTO

         O pedido ENTRA na esquerda e SAI pela direita — quem olha de longe sabe
         o estado da cozinha pela coluna mais cheia, sem ler card nenhum.
         Toque no RODAPÉ do card avança a etapa (o cabeçalho abre o detalhe do
         pedido); entregar/coletar tira do quadro.

         Os rótulos são UMA palavra e começam com letras diferentes de propósito:
         "A PREPARAR" e "EM PREPARO" viravam a mesma mancha de tinta a três
         metros de distância, que é a distância de quem produz.

         OS QUE JÁ SAÍRAM (14/10/2026, pedido do dono): o botão "Saíram hoje" no cabeçalho da
         coluna PRONTO (o pedido sai pela direita) troca as três colunas pela lista dos que
         saíram; a faixa abaixo do cabeçalho aparece só com busca, e diz quantos estão no
         quadro e quantos já saíram. A lógica mora em Nucleo.FinalizadosKds. -->
    <Grid Background="{DynamicResource Fundo}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BarraDegrade}" Padding="20,12"
                BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1">
            <!-- DUAS COLUNAS, e nao um Grid solto com dois StackPanel por cima do outro.
                 Sem elas os dois se sobrepoem e o da direita, que tem fundo opaco, e
                 desenhado EM CIMA do status. Medido: os botoes da direita passaram de
                 260 px para 611 quando o seletor de comanda entrou, e em 1366x768 e
                 1024x768 — resolucao de balcao — o TxtStatus ia parar debaixo deles.
                 A frase que sumia era justamente "a comanda do #N nao saiu, confira papel
                 e impressora": o aviso que existe para a cozinha nao ficar sem papel.
                 Coluna * para o texto, Auto para os botoes, e reticencias no status: em
                 tela estreita ele encolhe, nunca some por baixo. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍩" FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="PEDIDOS" Foreground="{DynamicResource Texto}" FontSize="20"
                               FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                               Margin="14,0,8,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- BUSCA POR NUMERO (11/09/2026, pedido do dono). Digitou, o quadro mostra
                         so os pedidos cujo numero contem os digitos; apagou, volta tudo. No
                         caixa touch o toque no campo abre o teclado do Windows. -->
                    <Border CornerRadius="10" BorderThickness="1" Padding="8,0" Margin="0,0,8,0"
                            Background="{DynamicResource Painel}" BorderBrush="{DynamicResource Borda}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="IconeBusca" Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtBusca" Width="120" MinHeight="34" FontSize="15" BorderThickness="0"
                                     Background="Transparent" VerticalContentAlignment="Center"
                                     Tag="nº do pedido" ToolTip="Procurar um pedido pelo número"
                                     TextChanged="BuscaMudou" GotFocus="BuscaFocou"/>
                            <!-- BotaoBase, e nao BotaoTexto: esse mora nos Resources da Venda e daqui nao se alcanca
                                 (a 1.0.4 caiu ao abrir o Delivery por causa disso). -->
                            <Button x:Name="BtnLimparBusca" Content="✕" Click="LimparBusca" Visibility="Collapsed"
                                    Style="{StaticResource BotaoBase}" MinHeight="28" MinWidth="28" Padding="6,0" FontSize="13"
                                    VerticalAlignment="Center" ToolTip="Limpar a busca"/>
                        </StackPanel>
                    </Border>
                    <!-- ONDE A COMANDA SAI — no cabeçalho, e não só no assistente (29/08).
                         Relato do dono, com o PDV já instalado na loja: "apos instalado,
                         nao mostra a impressora no PDV na aba de delivery, somente no dash
                         principal". A escolha existia dentro de Configuração → Impressora;
                         só que quem opera a cozinha procura onde a comanda sai JUNTO dos
                         pedidos. Não achando, conclui que o PDV não deixa escolher.

                         O botão é um RÓTULO que também é o alvo do toque: ele diz o destino
                         de agora ("mesma do cupom (EPSON TM-T20)" é informação, não vazio) e
                         abre o seletor. Grava nas MESMAS chaves do assistente — segunda
                         fonte de verdade sobre onde o papel sai diverge no primeiro dia, e
                         quem descobre é a cozinha com o pedido na mão. -->
                    <Button x:Name="BtnDestinoComanda" Click="TrocarDestinoComanda"
                            Style="{StaticResource BotaoBarra}"
                            ToolTip="Escolher em qual impressora saem as comandas do delivery">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDestinoComanda" Text="Comanda…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Atualizar" Style="{StaticResource BotaoBarra}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtIconeAtualiza" Text="⟳" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Atualizar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Voltar" Style="{StaticResource BotaoBarra}" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontSize="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Voltar ao caixa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- A FAIXA DA BUSCA (14/10/2026). Só aparece com busca: "No quadro: nenhum. Já saíram: 1."
             e o atalho para a lista. Mora aqui, e não na linha de aviso do cabeçalho, porque a
             1024x768 aquela linha fica com largura perto de zero (os botões da direita comem
             tudo) e a contagem da busca nunca aparecia. Também é onde a etiqueta lida dentro
             da busca avisa o que fazer. -->
        <Border x:Name="FaixaBusca" Grid.Row="1" Visibility="Collapsed" Margin="16,10,16,0" Padding="16,4,6,4"
                CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource ChipInfoFundo}" BorderBrush="{DynamicResource ChipInfoBorda}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFaixaBusca" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Texto}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                <Button x:Name="BtnVerSairam" Grid.Column="1" Click="VerOsQueSairam"
                        Style="{StaticResource BotaoBarra}" MinHeight="44" FontWeight="Bold"
                        ToolTip="Ver os pedidos que já saíram do quadro">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtVerSairam" Text="Ver os que saíram" VerticalAlignment="Center"/>
                        <TextBlock Text="›" FontSize="18" Margin="8,-2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="Quadro" Grid.Row="2" Margin="12,10,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- coluna 1: chegou, ninguém pegou -->
            <Border Grid.Column="0" Margin="4,0" CornerRadius="14"
                    Background="{DynamicResource FundoAfundado}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" CornerRadius="14,14,0,0"
                            Background="{DynamicResource ChipInfoFundo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NA FILA" Foreground="{DynamicResource Ciano}"
                                       FontSize="14" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtQtdPreparar" Text="0" Foreground="{DynamicResource Ciano}"
                                       FontSize="14" FontWeight="Bold" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8">
                        <Grid x:Name="ColPreparar"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- coluna 2: no forno -->
            <Border Grid.Column="1" Margin="4,0" CornerRadius="14"
                    Background="{DynamicResource FundoAfundado}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" CornerRadius="14,14,0,0"
                            Background="{DynamicResource ChipAlertaFundo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FAZENDO" Foreground="{DynamicResource Amarelo}"
                                       FontSize="14" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtQtdPreparo" Text="0" Foreground="{DynamicResource Amarelo}"
                                       FontSize="14" FontWeight="Bold" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8">
                        <Grid x:Name="ColPreparo"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- coluna 3: pronto, esperando entregador/cliente -->
            <Border Grid.Column="2" Margin="4,0" CornerRadius="14"
                    Background="{DynamicResource FundoAfundado}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" CornerRadius="14,14,0,0"
                            Background="{DynamicResource ChipOkFundo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PRONTO" Foreground="{DynamicResource Ok}"
                                           FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtQtdPronto" Text="0" Foreground="{DynamicResource Ok}"
                                           FontSize="14" FontWeight="Bold" Margin="8,0,0,0"/>
                            </StackPanel>
                            <!-- SAÍRAM HOJE (14/10/2026): a entrada da lista dos que já saíram. Aqui, e
                                 não no cabeçalho de cima (que a 1024 não tem um pixel sobrando), porque
                                 o pedido sai do quadro por esta coluna. As margens negativas deixam o
                                 botão com 36 px sem engordar o cabeçalho: as três colunas continuam
                                 com o cabeçalho da mesma altura. -->
                            <Button x:Name="BtnSairamHoje" Grid.Column="1" Click="AbrirSairamHoje"
                                    Style="{StaticResource BotaoBarra}" HorizontalAlignment="Right"
                                    MinHeight="36" Margin="8,-8,-6,-8" Padding="12,0" FontSize="13"
                                    ToolTip="Ver os pedidos que já saíram do quadro">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtSairamHoje" Text="Saíram hoje: 0" VerticalAlignment="Center"/>
                                    <TextBlock Text="›" FontSize="16" Margin="6,-2,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8">
                        <Grid x:Name="ColPronto"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- OS QUE JÁ SAÍRAM (14/10/2026). Ocupa o lugar das três colunas; o cabeçalho de cima
             continua igual (a busca dele filtra esta lista por número ou nome). As linhas são
             montadas em código (Kds.xaml.cs, LinhaDaLista); a régua de quem entra, em que ordem
             e com que rótulo é do Nucleo.FinalizadosKds. A lista NÃO se redesenha no timer de
             10 s, senão perderia a rolagem: recarrega ao abrir, ao trocar o dia ou a busca, e no
             Atualizar. -->
        <Border x:Name="PainelFinalizados" Grid.Row="2" Visibility="Collapsed" Margin="16,10,16,12" CornerRadius="14"
                Background="{DynamicResource FundoAfundado}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="10,8" CornerRadius="14,14,0,0" Background="{DynamicResource ChipOkFundo}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnVoltarQuadro" Click="VoltarAoQuadro" Style="{StaticResource BotaoBarra}"
                                    Margin="0" FontWeight="Bold" ToolTip="Volta para as três colunas">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="←" FontSize="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Voltar ao quadro" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnHoje" Click="EscolherPeriodo" Tag="Hoje" Style="{StaticResource BotaoBarra}" Margin="12,0,0,0" Content="Hoje"/>
                            <Button x:Name="BtnOntem" Click="EscolherPeriodo" Tag="Ontem" Style="{StaticResource BotaoBarra}" Content="Ontem"/>
                            <Button x:Name="Btn7Dias" Click="EscolherPeriodo" Tag="SeteDias" Style="{StaticResource BotaoBarra}" Content="7 dias"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtFonteLista" Grid.Column="1" FontSize="13" Foreground="{DynamicResource TextoFraco}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,6,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="TxtAvisoLista" Grid.Row="1" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextoEspera}" Margin="18,10,18,0" TextTrimming="CharacterEllipsis"/>
                <ScrollViewer x:Name="RolFinalizados" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,8,10,8"
                              PanningMode="VerticalOnly">
                    <StackPanel x:Name="ListaFinalizados"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- DETALHE DO PEDIDO (04/09, pedido do dono olhando o KDS na loja): "um pop-up
             que quando clica ele visualiza o pedido, com uma tela melhor, assim como é o
             iFood". Abre pelo toque no CABEÇALHO do card, em qualquer coluna.

             É uma camada POR CIMA do quadro, não uma tela nova nem uma janela: o dono já
             reprovou "adicionar mais coisas no menu", e janela à parte não sairia na foto
             do modo foto-kds. O véu escurece o quadro (e fecha no toque); o painel é montado
             em código por Telas/DetalhePedidoKds. Fecha pelo botão grande, pelo Esc ou
             pelo toque fora — nada de X pequeno no canto de uma tela de toque. -->
        <Grid x:Name="Veu" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Border Background="{DynamicResource Fundo}" Opacity="0.82" MouseLeftButtonDown="ToqueNoVeu"/>
            <!-- Stretch + MaxWidth: o painel ocupa até 760 px e o WPF o centraliza quando
                 sobra tela. Center na vertical: ele encolhe até o conteúdo e, quando o
                 pedido é comprido, para na margem e a lista de itens ROLA por dentro. -->
            <ContentControl x:Name="PainelDetalhe" Margin="24" MaxWidth="760" Focusable="False"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
