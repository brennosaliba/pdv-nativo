<UserControl x:Class="Pdv.Telas.Kds"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- KDS em QUADRO, espelhando o fluxo do KDS da Savassi
         (NEW → IN_PRODUCTION → READY → CONCLUDED):

           NA FILA   →   FAZENDO   →   PRONTO

         O pedido ENTRA na esquerda e SAI pela direita — quem olha de longe sabe
         o estado da cozinha pela coluna mais cheia, sem ler card nenhum.
         Toque no card avança a etapa; entregar/coletar tira do quadro.

         Os rótulos são UMA palavra e começam com letras diferentes de propósito:
         "A PREPARAR" e "EM PREPARO" viravam a mesma mancha de tinta a três
         metros de distância, que é a distância de quem produz. -->
    <Grid Background="{DynamicResource Fundo}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BarraDegrade}" Padding="20,12"
                BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1">
            <!-- DUAS COLUNAS, e nao um Grid solto com dois StackPanel por cima do outro.
                 Sem elas os dois se sobrepoem e o da direita, que tem fundo opaco, e
                 desenhado EM CIMA do status. Medido: os botoes da direita passaram de
                 260 px para 611 quando o seletor de comanda entrou, e em 1366x768 e
                 1024x768 — resolucao de balcao — o TxtStatus ia parar debaixo deles.
                 A frase que sumia era justamente "a comanda do #N nao saiu, confira papel
                 e impressora": o aviso que existe para a cozinha nao ficar sem papel.
                 Coluna * para o texto, Auto para os botoes, e reticencias no status: em
                 tela estreita ele encolhe, nunca some por baixo. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍩" FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="PEDIDOS" Foreground="{DynamicResource Texto}" FontSize="20"
                               FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                               Margin="14,0,8,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- ONDE A COMANDA SAI — no cabeçalho, e não só no assistente (29/08).
                         Relato do dono, com o PDV já instalado na loja: "apos instalado,
                         nao mostra a impressora no PDV na aba de delivery, somente no dash
                         principal". A escolha existia dentro de Configuração → Impressora;
                         só que quem opera a cozinha procura onde a comanda sai JUNTO dos
                         pedidos. Não achando, conclui que o PDV não deixa escolher.

                         O botão é um RÓTULO que também é o alvo do toque: ele diz o destino
                         de agora ("mesma do cupom (EPSON TM-T20)" é informação, não vazio) e
                         abre o seletor. Grava nas MESMAS chaves do assistente — segunda
                         fonte de verdade sobre onde o papel sai diverge no primeiro dia, e
                         quem descobre é a cozinha com o pedido na mão. -->
                    <Button x:Name="BtnDestinoComanda" Click="TrocarDestinoComanda"
                            Style="{StaticResource BotaoBarra}"
                            ToolTip="Escolher em qual impressora saem as comandas do delivery">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDestinoComanda" Text="Comanda…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Atualizar" Style="{StaticResource BotaoBarra}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtIconeAtualiza" Text="⟳" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Atualizar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Voltar" Style="{StaticResource BotaoBarra}" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" FontSize="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Voltar ao caixa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,10,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- coluna 1: chegou, ninguém pegou -->
            <Border Grid.Column="0" Margin="4,0" CornerRadius="14"
                    Background="{DynamicResource FundoAfundado}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" CornerRadius="14,14,0,0"
                            Background="{DynamicResource ChipInfoFundo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NA FILA" Foreground="{DynamicResource Ciano}"
                                       FontSize="14" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtQtdPreparar" Text="0" Foreground="{DynamicResource Ciano}"
                                       FontSize="14" FontWeight="Bold" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8">
                        <Grid x:Name="ColPreparar"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- coluna 2: no forno -->
            <Border Grid.Column="1" Margin="4,0" CornerRadius="14"
                    Background="{DynamicResource FundoAfundado}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" CornerRadius="14,14,0,0"
                            Background="{DynamicResource ChipAlertaFundo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FAZENDO" Foreground="{DynamicResource Amarelo}"
                                       FontSize="14" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtQtdPreparo" Text="0" Foreground="{DynamicResource Amarelo}"
                                       FontSize="14" FontWeight="Bold" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8">
                        <Grid x:Name="ColPreparo"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- coluna 3: pronto, esperando entregador/cliente -->
            <Border Grid.Column="2" Margin="4,0" CornerRadius="14"
                    Background="{DynamicResource FundoAfundado}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" CornerRadius="14,14,0,0"
                            Background="{DynamicResource ChipOkFundo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PRONTO" Foreground="{DynamicResource Ok}"
                                       FontSize="14" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtQtdPronto" Text="0" Foreground="{DynamicResource Ok}"
                                       FontSize="14" FontWeight="Bold" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8">
                        <Grid x:Name="ColPronto"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
