<UserControl x:Class="Pdv.Telas.AberturaCaixa"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Pdv.Telas"
             Background="{DynamicResource Fundo}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">

            <TextBlock Text="Abertura de caixa" Style="{StaticResource Titulo}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtOperador" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

            <TextBlock Text="Quanto tem em dinheiro na gaveta agora?" Style="{StaticResource Rotulo}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Conte antes de digitar: é com este valor que o caixa fecha no fim do dia."
                       Foreground="{DynamicResource TextoFraco}" FontSize="12.5"
                       HorizontalAlignment="Center" Margin="0,2,0,8" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="380"/>

            <Border Background="{DynamicResource Painel}" CornerRadius="14" Padding="18,14" Margin="5,0,5,6">
                <TextBlock x:Name="TxtValor" Text="R$ 0,00" FontSize="46" FontWeight="Bold"
                           Foreground="{DynamicResource Marca}" HorizontalAlignment="Center"/>
            </Border>

            <!-- Aviso em caixa de destaque: "caixa de outro dia preso" competia em
                 igualdade com o resto da tela e o operador abria por cima sem ler. -->
            <Border x:Name="CaixaAviso" Visibility="Collapsed" CornerRadius="12"
                    Background="{DynamicResource AvisoFundo}" BorderBrush="{DynamicResource AvisoBorda}" BorderThickness="1.5"
                    Padding="14,10" Margin="5,0,5,8">
                <TextBlock x:Name="TxtErro" Foreground="{DynamicResource Amarelo}" FontSize="15"
                           FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>

            <!-- Caixa de outro dia preso aberto: o caminho de fechar tem que estar AQUI,
                 senão a tela vira beco sem saída (o fechamento normal mora na tela de
                 venda, que só abre com caixa do dia). -->
            <Button x:Name="BtnFecharAntigo" Visibility="Collapsed" Click="FecharAntigo"
                    Style="{StaticResource BotaoBase}" MinHeight="56" FontSize="16"
                    Margin="5,0,5,10" Foreground="{DynamicResource Amarelo}"/>

            <t:TecladoNumerico x:Name="Teclado"/>

            <Grid Margin="5,14,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Sair" Click="Sair" Style="{StaticResource BotaoBase}" Margin="0,0,5,0"/>
                <Button Grid.Column="1" x:Name="BtnAbrir" Content="Abrir caixa" Click="Abrir"
                        Style="{StaticResource BotaoPrincipal}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
