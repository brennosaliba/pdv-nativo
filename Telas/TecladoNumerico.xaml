<UserControl x:Class="Pdv.Telas.TecladoNumerico"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Layout de telefone (1 no topo): é o que a mão do operador já conhece de
         maquininha e celular. Calculadora (7 no topo) confunde quem digita rápido. -->
    <UniformGrid Rows="4" Columns="3">
        <Button Style="{StaticResource BotaoTecla}" Content="1" Click="Tecla"/>
        <Button Style="{StaticResource BotaoTecla}" Content="2" Click="Tecla"/>
        <Button Style="{StaticResource BotaoTecla}" Content="3" Click="Tecla"/>
        <Button Style="{StaticResource BotaoTecla}" Content="4" Click="Tecla"/>
        <Button Style="{StaticResource BotaoTecla}" Content="5" Click="Tecla"/>
        <Button Style="{StaticResource BotaoTecla}" Content="6" Click="Tecla"/>
        <Button Style="{StaticResource BotaoTecla}" Content="7" Click="Tecla"/>
        <Button Style="{StaticResource BotaoTecla}" Content="8" Click="Tecla"/>
        <Button Style="{StaticResource BotaoTecla}" Content="9" Click="Tecla"/>
        <Button Style="{StaticResource BotaoTecla}" Content="C" Click="Limpar" Foreground="{StaticResource TextoFraco}"/>
        <Button Style="{StaticResource BotaoTecla}" Content="0" Click="Tecla"/>
        <Button Style="{StaticResource BotaoTecla}" Content="⌫" Click="Apagar" Foreground="{StaticResource TextoFraco}"/>
    </UniformGrid>
</UserControl>
