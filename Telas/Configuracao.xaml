<UserControl x:Class="Pdv.Telas.Configuracao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Fundo}">
    <Grid Margin="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,24,0,24">
            <StackPanel Width="560" HorizontalAlignment="Center">

                <TextBlock Text="Configuração do caixa" Style="{StaticResource Titulo}"/>
                <TextBlock Text="Preenchido uma vez. Depois disso o caixa abre direto no login."
                           Style="{StaticResource Rotulo}" Margin="0,4,0,22"/>

                <TextBlock Text="LOJA" Foreground="{DynamicResource Marca}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Text="Nome da loja" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="TxtLoja" Margin="0,4,0,12"/>
                <TextBlock Text="CNPJ" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="TxtCnpj" Margin="0,4,0,2" MaxLength="18" TextChanged="FormatarCnpj"/>
                <TextBlock x:Name="TxtStatusCnpj" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                           TextWrapping="Wrap" MinHeight="16" Margin="0,0,0,12"/>

                <TextBlock Text="FISCAL" Foreground="{DynamicResource Marca}" FontWeight="Bold" FontSize="13" Margin="0,10,0,8"/>
                <TextBlock Text="Série deste caixa" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="TxtSerie" Margin="0,4,0,2" MaxLength="3"/>
                <TextBlock Text="Cada caixa precisa de uma série só dele — duas fontes na mesma série geram numeração duplicada e a SEFAZ rejeita."
                           Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Ambiente" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="CmbAmbiente" Margin="0,4,0,12" FontSize="18" Padding="10,8"
                          SelectionChanged="AmbienteMudou">
                    <ComboBoxItem Content="Homologação (teste — sem valor fiscal)" IsSelected="True"/>
                    <ComboBoxItem Content="Produção (nota vale de verdade)"/>
                    <ComboBoxItem Content="Sem emissão — só recibo (sem NFC-e)"/>
                </ComboBox>
                <TextBlock Text="Dá pra mudar aqui a qualquer momento (com a senha de administrador) — ex.: começar em homologação ou só recibo e ligar a produção depois."
                           Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,-8,0,12"/>

                <TextBlock Text="Endereço do servidor (IP ou domínio)" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="TxtApi" Margin="0,4,0,12"/>

                <!-- Revelação progressiva: no modo "Sem emissão — só recibo" estes
                     campos não fazem sentido e SOMEM (AmbienteMudou controla). -->
                <StackPanel x:Name="BlocoCertificado">
                    <TextBlock Text="Certificado digital A1 (.pfx)" Style="{StaticResource Rotulo}"/>
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPfx" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                        <Button x:Name="BtnPfx" Grid.Column="1" Content="Escolher" Click="EscolherPfx"
                                Style="{StaticResource BotaoBase}" MinHeight="48" FontSize="15" Padding="18,0"/>
                    </Grid>
                    <TextBlock Text="Senha do certificado" Style="{StaticResource Rotulo}"/>
                    <PasswordBox x:Name="TxtSenhaPfx" Margin="0,4,0,2" FontSize="18" Padding="12,10"
                                 Background="{DynamicResource Painel}" Foreground="{DynamicResource Texto}"
                                 BorderBrush="{DynamicResource Borda}" PasswordChanged="ConferirCert"/>
                    <TextBlock x:Name="TxtStatusCert" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                               TextWrapping="Wrap" MinHeight="18" Margin="0,0,0,12"/>

                    <TextBlock Text="CSC (código de segurança do contribuinte)" Style="{StaticResource Rotulo}"/>
                    <PasswordBox x:Name="TxtCsc" Margin="0,4,0,12" FontSize="18" Padding="12,10"
                                 Background="{DynamicResource Painel}" Foreground="{DynamicResource Texto}"
                                 BorderBrush="{DynamicResource Borda}"/>
                    <TextBlock Text="ID do CSC" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtIdCsc" Margin="0,4,0,12" MaxLength="6"/>
                </StackPanel>

                <!-- O teste vem AQUI, colado no fim da parte fiscal: ele confere a
                     COMUNICAÇÃO (CNPJ, certificado, CSC, emissor, servidor). O
                     pareamento é outra etapa — é a última e é obrigatória. -->
                <TextBlock Text="TESTE GERAL" Foreground="{DynamicResource Marca}" FontWeight="Bold" FontSize="13" Margin="0,10,0,8"/>
                <Button x:Name="BtnTestarTudo" Content="🧪 Testar configuração" Click="TestarConfiguracao"
                        Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtStatusTeste"
                           Text="Confere a comunicação de uma vez: CNPJ, certificado, CSC, emissor fiscal e servidor."
                           Foreground="{DynamicResource TextoFraco}" FontSize="12.5" FontFamily="Consolas"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="IMPRESSORA" Foreground="{DynamicResource Marca}" FontWeight="Bold" FontSize="13" Margin="0,10,0,8"/>
                <TextBlock Text="Impressora do cupom" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="CboImpressora" Margin="0,4,0,6" FontSize="16" Padding="12,10"/>
                <TextBlock Text="Bobina de 80mm. Em branco, usa a impressora padrão do Windows."
                           Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkImprimirAuto" Content="Imprimir cupom/recibo automaticamente ao concluir a venda"
                          IsChecked="True" FontSize="14" Margin="0,0,0,8"/>
                <Button x:Name="BtnTesteImpressao" Content="Imprimir cupom de teste" Click="TestarImpressao"
                        Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtStatusImpressao" Foreground="{DynamicResource TextoFraco}" FontSize="12.5"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <!-- TEF: como este caixa cobra cartão/PIX. É configuração da MÁQUINA (vai
                     na tabela config, que é o que Servicos.Tef() lê). O PayGo Windows é
                     troca de arquivos local: a pasta aqui tem que ser a MESMA configurada
                     no PayGo; o registro 738 a PayGo entrega na certificação. -->
                <TextBlock Text="TEF (CARTÃO / PIX)" Foreground="{DynamicResource Marca}" FontWeight="Bold" FontSize="13" Margin="0,10,0,8"/>
                <TextBlock Text="Como o caixa cobra cartão e PIX" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="CboTef" Margin="0,4,0,6" FontSize="16" Padding="12,10" SelectionChanged="TefMudou">
                    <ComboBoxItem Content="Sem TEF — cartão registrado na mão (maquininha avulsa)"/>
                    <ComboBoxItem Content="Smart TEF pela nuvem (maquininha Rede)"/>
                    <ComboBoxItem Content="PayGo Windows (troca de arquivos, nesta máquina)"/>
                    <ComboBoxItem Content="ControlPay — WebService da PayGo (PayGo Windows como terminal)"/>
                </ComboBox>
                <StackPanel x:Name="BlocoPayGo" Visibility="Collapsed">
                    <TextBlock Text="Pasta do PayGo (a mesma configurada no PayGo Windows)" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtPayGoPasta" Margin="0,4,0,8" Tag="C:\PAYGO"/>
                    <TextBlock Text="Registro de certificação (campo 738) — a PayGo fornece; em branco no sandbox" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtPayGoRegistro" Margin="0,4,0,8"/>
                    <TextBlock Text="Razão social da automação (campo 716)" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtPayGoEmpresa" Margin="0,4,0,8" Tag="AMERICAN DAY"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rede pré-selecionada p/ cartão (010)" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="TxtPayGoRede" Margin="0,4,0,0" Tag="vazio = menu do PayGo"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Rede p/ PIX (010)" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="TxtPayGoRedePix" Margin="0,4,0,0" Tag="ex.: PIX C6 BANK"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BtnTestarPayGo" Content="Testar PayGo (ATV)" Click="TestarPayGo"
                                Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16"/>
                        <Button Grid.Column="2" x:Name="BtnMenuPayGo" Content="Menu administrativo (ADM)" Click="MenuPayGo"
                                Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16"/>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="BlocoControlPay" Visibility="Collapsed">
                    <TextBlock Text="O PayGo Windows desta máquina precisa estar ativado como terminal ControlPay (é ele quem fala com o pinpad). O PDV cria a venda na API e acompanha o status."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Ambiente" Style="{StaticResource Rotulo}"/>
                    <ComboBox x:Name="CmbCpayAmbiente" Margin="0,4,0,8" FontSize="16" Padding="12,10">
                        <ComboBoxItem Content="Sandbox (homologação) — sandbox.controlpay.com.br"/>
                        <ComboBoxItem Content="Produção — api.controlpay.com.br"/>
                    </ComboBox>
                    <TextBlock Text="Chave de integração (portal ControlPay → Integrações/Config. → Chaves de integração)" Style="{StaticResource Rotulo}"/>
                    <PasswordBox x:Name="PwdCpayChave" Margin="0,4,0,8" FontSize="18" Padding="12,10"
                                 Background="{DynamicResource Painel}" Foreground="{DynamicResource Texto}"
                                 BorderBrush="{DynamicResource Borda}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ID do terminal" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="TxtCpayTerminal" Margin="0,4,0,0" Tag="ex.: 6408"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ID da pessoa" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="TxtCpayPessoa" Margin="0,4,0,0" Tag="ex.: 12247"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Senha técnica" Style="{StaticResource Rotulo}"/>
                            <PasswordBox x:Name="PwdCpaySenha" Margin="0,4,0,0" FontSize="18" Padding="12,10"
                                         Background="{DynamicResource Painel}" Foreground="{DynamicResource Texto}"
                                         BorderBrush="{DynamicResource Borda}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BtnTestarCpay" Content="Testar ControlPay (listar terminais)" Click="TestarControlPay"
                                Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16"/>
                        <Button Grid.Column="2" x:Name="BtnMenuCpay" Content="Menu administrativo (ADM)" Click="MenuPayGo"
                                Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16"/>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="BlocoTefNuvem" Visibility="Collapsed">
                    <TextBlock Text="Serial da maquininha (vazio = terminal padrão da conta)" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtTefSerial" Margin="0,4,0,8"/>
                </StackPanel>
                <StackPanel x:Name="BlocoTefOpcoes" Visibility="Collapsed">
                    <CheckBox x:Name="ChkPayGoVias" IsChecked="True" FontSize="14" Margin="0,0,0,8"
                              Content="Imprimir as vias do comprovante (cliente e estabelecimento) na impressora do cupom"/>
                    <CheckBox x:Name="ChkTefParcelas" IsChecked="False" FontSize="14" Margin="0,0,0,8"
                              Content="Perguntar o número de parcelas no crédito (desligado: crédito sai à vista)"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatusTef" Foreground="{DynamicResource TextoFraco}" FontSize="12.5"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="APARÊNCIA" Foreground="{DynamicResource Marca}"
                           FontWeight="Bold" FontSize="13" Margin="0,10,0,8"/>
                <TextBlock Text="Tema da tela" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="CboTema" Margin="0,4,0,6" FontSize="16" Padding="12,10"
                          SelectionChanged="TemaSelecionado">
                    <ComboBoxItem Content="Escuro (noturno)"/>
                    <ComboBoxItem Content="Claro (diurno)"/>
                    <ComboBoxItem Content="Automático por horário"/>
                </ComboBox>
                <StackPanel x:Name="BlocoJanelaTema" Orientation="Horizontal" Visibility="Collapsed"
                            Margin="0,0,0,6">
                    <TextBlock Text="Claro de" Style="{StaticResource Rotulo}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtTemaDe" Width="110" Margin="8,0,0,0" Tag="06:00"
                             LostFocus="JanelaTemaMudou"/>
                    <TextBlock Text="até" Style="{StaticResource Rotulo}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="TxtTemaAte" Width="110" Margin="8,0,0,0" Tag="18:00"
                             LostFocus="JanelaTemaMudou"/>
                </StackPanel>
                <TextBlock Text="A escolha vale para ESTA máquina (é a luz do balcão que decide, não a pessoa logada). No automático a tela clareia dentro da janela e escurece fora — mas nunca troca com uma venda aberta."
                           Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <!-- Sem bloco NUVEM e sem senha de admin aqui, por decisão do dono:
                     o catálogo desce pela chave pública (botão Sincronizar) e a senha
                     de administrador passa a ser gerida pelo painel. Menos campo na
                     tela do caixa = menos jeito de configurar errado. -->

                <TextBlock x:Name="TxtPrimeiroOperador" Text="ADMINISTRADOR DA LOJA (DONO)" Foreground="{DynamicResource Marca}"
                           FontWeight="Bold" FontSize="13" Margin="0,10,0,8"/>
                <StackPanel x:Name="BlocoOperador">
                    <TextBlock Text="Nome" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtOpNome" Margin="0,4,0,12"/>
                    <TextBlock Text="CPF (é o login dele no caixa)" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtOpCpf" Margin="0,4,0,12" MaxLength="14"/>
                    <TextBlock Text="Senha (4 a 6 dígitos)" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtOpPin" Margin="0,4,0,2" MaxLength="6"/>
                    <TextBlock Text="O primeiro cadastro é sempre o ADMINISTRADOR (dono): entra com todos os privilégios — autoriza sangria, cancelamento e a própria tela de configuração passa a abrir com a senha dele."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                </StackPanel>

                <!-- ÚLTIMA etapa e OBRIGATÓRIA: sem parear não salva. A integração
                     com o painel é o que faz vendas e notas subirem. -->
                <TextBlock Text="INTEGRAÇÃO / PAREAMENTO (obrigatório)" Foreground="{DynamicResource Marca}" FontWeight="Bold" FontSize="13" Margin="0,10,0,8"/>
                <Button x:Name="BtnParear" Content="Parear com o painel (código de 6 dígitos)" Click="Parear"
                        Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtStatusPareamento"
                           Text="Obrigatório: o pareamento é o que sobe vendas e notas pro painel. Sem ele, o Salvar não conclui."
                           Foreground="{DynamicResource TextoFraco}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock x:Name="TxtErro" Foreground="{DynamicResource Erro}" FontSize="14"
                           TextWrapping="Wrap" MinHeight="30" Margin="0,6,0,0"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnVoltar" Content="Voltar" Click="Voltar"
                            Style="{StaticResource BotaoBase}" Margin="0,0,5,0" Visibility="Collapsed"/>
                    <Button Grid.Column="1" x:Name="BtnSalvar" Content="Salvar e continuar" Click="Salvar"
                            Style="{StaticResource BotaoPrincipal}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
