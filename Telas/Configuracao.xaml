<UserControl x:Class="Pdv.Telas.Configuracao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Fundo}">
    <!-- ASSISTENTE DE 5 PASSOS (era um formulário único de 8 seções e ~2.000 px de
         rolagem). Cada passo é um StackPanel na MESMA célula do Grid; só um está
         visível por vez (IrPara). Três razões para a troca:
           · quem instala o caixa faz isso UMA vez e não sabe o que pode ficar em
             branco — a rolagem infinita não diz onde termina a obrigação;
           · o que BLOQUEIA fica no rodapé, sempre à vista, e não num popup que
             aparece só depois de clicar Salvar;
           · o Salvar continua sendo a porta ÚNICA de escrita: os passos só coletam. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── CABEÇALHO + TRILHA ─────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Width="620" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock x:Name="TxtPassoNumero" Text="PASSO 1 DE 5"
                       Foreground="{DynamicResource Marca}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtTitulo" Text="Loja" Style="{StaticResource Titulo}"/>
            <TextBlock x:Name="TxtSubtitulo" Style="{StaticResource Rotulo}" TextWrapping="Wrap" Margin="0,4,0,14"/>
            <!-- A trilha é indicador E atalho. Na 1ª instalação as abas ficam
                 DESLIGADAS (só indicam): pular passo é como se instala um caixa pela
                 metade. Reconfigurando, cada aba é clicável — ver Configuracao.xaml.cs.
                 O estilo não apaga o desligado de propósito: mesmo sem clique, a trilha
                 é o único lugar que mostra o caminho inteiro. -->
            <UniformGrid x:Name="Trilha" Columns="5" Margin="0,0,-8,16">
                <RadioButton x:Name="AbaLoja" GroupName="passo" Style="{StaticResource PassoTrilha}"
                             Content="1 · Loja" Tag="0" Checked="AbaEscolhida"/>
                <RadioButton x:Name="AbaFiscal" GroupName="passo" Style="{StaticResource PassoTrilha}"
                             Content="2 · Nota fiscal" Tag="1" Checked="AbaEscolhida"/>
                <RadioButton x:Name="AbaImpressora" GroupName="passo" Style="{StaticResource PassoTrilha}"
                             Content="3 · Impressora" Tag="2" Checked="AbaEscolhida"/>
                <RadioButton x:Name="AbaMaquininha" GroupName="passo" Style="{StaticResource PassoTrilha}"
                             Content="4 · Maquininha" Tag="3" Checked="AbaEscolhida"/>
                <RadioButton x:Name="AbaPareamento" GroupName="passo" Style="{StaticResource PassoTrilha}"
                             Content="5 · Pareamento" Tag="4" Checked="AbaEscolhida"/>
            </UniformGrid>
        </StackPanel>

        <!-- ── CONTEÚDO DO PASSO ──────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Width="620" HorizontalAlignment="Center" Margin="0,0,0,10">

                <!-- 1 · LOJA ─────────────────────────────────────────────── -->
                <StackPanel x:Name="PassoLoja">
                    <TextBlock Text="Nome da loja" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtLoja" Margin="0,4,0,12" TextChanged="CampoMudou"/>

                    <TextBlock Text="CNPJ" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtCnpj" Margin="0,4,0,2" MaxLength="18" TextChanged="FormatarCnpj"/>
                    <TextBlock x:Name="TxtStatusCnpj" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                               TextWrapping="Wrap" MinHeight="16" Margin="0,0,0,12"/>

                    <!-- IE: campo novo. Vai para `config` e não para a tabela `terminal`
                         porque Migrar() não faz ALTER — coluna nova só existiria em
                         máquina nova, e a que já roda ficaria sem. -->
                    <TextBlock Text="Inscrição estadual" Style="{StaticResource Rotulo}"/>
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtIe" Grid.Column="0" Margin="0,0,8,0" MaxLength="20"
                                 Tag="só os números" TextChanged="CampoMudou"/>
                        <!-- Botão e não checkbox: "ISENTO" é o VALOR do campo (é o que sai
                             impresso no cupom), não uma opção paralela a ele. -->
                        <Button x:Name="BtnIsento" Grid.Column="1" Content="ISENTO" Click="MarcarIsento"
                                Style="{StaticResource BotaoBase}" MinHeight="52" FontSize="15" Padding="20,0"/>
                    </Grid>
                    <TextBlock x:Name="TxtStatusIe" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                               TextWrapping="Wrap" MinHeight="16" Margin="0,0,0,16"/>

                    <TextBlock Text="O que sai no papel" Style="{StaticResource Rotulo}" Margin="0,0,0,6"/>
                    <UniformGrid Columns="2" Margin="0,0,-8,0">
                        <RadioButton x:Name="OpFiscalNfce" GroupName="fiscal" Style="{StaticResource BotaoOpcao}"
                                     MinHeight="104" Checked="ModoFiscalMudou">
                            <StackPanel>
                                <TextBlock Text="Cupom fiscal" FontWeight="Bold" FontSize="19"/>
                                <TextBlock Text="A nota oficial, autorizada pela SEFAZ. Precisa de certificado e do CSC (passo 2)."
                                           FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextoFraco}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OpFiscalRecibo" GroupName="fiscal" Style="{StaticResource BotaoOpcao}"
                                     MinHeight="104" Checked="ModoFiscalMudou">
                            <StackPanel>
                                <TextBlock Text="Só recibo" FontWeight="Bold" FontSize="19"/>
                                <TextBlock Text="Papel SEM VALOR FISCAL: nenhuma nota é emitida. Dá pra ligar o cupom fiscal depois."
                                           FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextoFraco}"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </StackPanel>

                <!-- 2 · NOTA FISCAL ──────────────────────────────────────── -->
                <StackPanel x:Name="PassoFiscal" Visibility="Collapsed">
                    <TextBlock Text="Série deste caixa" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="TxtSerie" Margin="0,4,0,2" MaxLength="3" TextChanged="SerieMudou"/>
                    <!-- 29/08 — pedido do dono: "ao escolher serie do caixa, se der erro,
                         mostra o erro POR CAUSA DA SÉRIE e altera para uma que seja
                         possível". Antes, série errada só aparecia na primeira venda, como
                         uma Rejeição 539 crua da SEFAZ que não dizia de quem era a culpa.
                         Esta linha nomeia a série; o botão ao lado troca por uma que o
                         painel garantiu ser deste caixa (e só aparece quando ela existe —
                         sugerir número no chute é pior que não sugerir nada). -->
                    <TextBlock x:Name="TxtStatusSerie" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                               TextWrapping="Wrap" MinHeight="16" Margin="0,0,0,6"/>
                    <Button x:Name="BtnUsarSerie" Visibility="Collapsed" Click="UsarSerieSugerida"
                            Style="{StaticResource BotaoBase}" MinHeight="44" FontSize="14"
                            HorizontalAlignment="Left" Padding="18,0" Margin="0,0,0,8"/>
                    <TextBlock Text="Cada caixa precisa da série dele. Dois caixas na mesma série repetem a numeração e a SEFAZ recusa as notas. O passo 5 traz a série que o painel reservou para este caixa."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- Em "Só recibo" nada aqui é exigido: dizer isso é melhor que
                         mostrar campos mortos ou uma tela vazia sem explicação. -->
                    <Border x:Name="AvisoRecibo" Visibility="Collapsed" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
                            Background="{DynamicResource AvisoFundo}" BorderBrush="{DynamicResource AvisoBorda}" BorderThickness="1">
                        <TextBlock Foreground="{DynamicResource Texto}" FontSize="13.5" TextWrapping="Wrap"
                                   Text="Este caixa está em SÓ RECIBO: não emite nota, então não pede certificado nem CSC. Para passar a emitir, volte ao passo 1 e escolha Cupom fiscal."/>
                    </Border>

                    <StackPanel x:Name="BlocoCertificado">
                        <TextBlock Text="Certificado digital A1 (o arquivo .pfx que o contador manda)" Style="{StaticResource Rotulo}"/>
                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPfx" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button x:Name="BtnPfx" Grid.Column="1" Content="Escolher" Click="EscolherPfx"
                                    Style="{StaticResource BotaoBase}" MinHeight="48" FontSize="15" Padding="18,0"/>
                        </Grid>
                        <TextBlock Text="Senha do certificado" Style="{StaticResource Rotulo}"/>
                        <PasswordBox x:Name="TxtSenhaPfx" Margin="0,4,0,2" FontSize="18" Padding="12,10"
                                     Background="{DynamicResource Painel}" Foreground="{DynamicResource Texto}"
                                     BorderBrush="{DynamicResource Borda}" PasswordChanged="ConferirCert"/>
                        <TextBlock x:Name="TxtStatusCert" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                                   TextWrapping="Wrap" MinHeight="18" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CSC" Style="{StaticResource Rotulo}"/>
                                <PasswordBox x:Name="TxtCsc" Margin="0,4,0,0" FontSize="18" Padding="12,10"
                                             Background="{DynamicResource Painel}" Foreground="{DynamicResource Texto}"
                                             BorderBrush="{DynamicResource Borda}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ID do CSC" Style="{StaticResource Rotulo}"/>
                                <TextBox x:Name="TxtIdCsc" Margin="0,4,0,0" MaxLength="6"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="O CSC e o ID saem do portal da SEFAZ do seu estado (lá ele aparece como &quot;código de segurança do contribuinte&quot;). Sem eles o cupom sai sem QR Code e a nota é recusada."
                                   Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,-4,0,12"/>
                    </StackPanel>

                    <!-- O teste fica AQUI, colado na parte fiscal: ele confere a
                         COMUNICAÇÃO (CNPJ, certificado, CSC, emissor). O pareamento é
                         outra etapa — é a última e é obrigatória. -->
                    <Button x:Name="BtnTestarTudo" Content="Testar a configuração fiscal" Click="TestarConfiguracao"
                            Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16" Margin="0,4,0,4"/>
                    <TextBlock x:Name="TxtStatusTeste"
                               Text="Confere de uma vez o CNPJ, o certificado, o CSC e o programa que emite a nota."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12.5" FontFamily="Consolas"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                </StackPanel>

                <!-- 3 · IMPRESSORA ───────────────────────────────────────── -->
                <StackPanel x:Name="PassoImpressora" Visibility="Collapsed">
                    <!-- 29/08 — o passo tem DUAS impressoras e elas se chamavam
                         "impressora" e "impressora da comanda". Quem instala não tem como
                         saber que a primeira é a do cupom fiscal: são dois títulos e cada
                         um diz QUE PAPEL sai ali. Nomear pelo papel, e não pelo lugar
                         ("do caixa", "da cozinha"), porque a loja pode ter as duas no
                         mesmo balcão — o papel é o que nunca muda. -->
                    <TextBlock Text="CUPOM FISCAL E RECIBO: O PAPEL DO CLIENTE" Foreground="{DynamicResource Marca}"
                               FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="Impressora do cupom fiscal / recibo" Style="{StaticResource Rotulo}"/>
                    <ComboBox x:Name="CboImpressora" Margin="0,4,0,4"/>
                    <TextBlock Text="É a que imprime o papel que o cliente leva: o cupom fiscal (NFC-e), o recibo e o comprovante do cartão."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Largura da bobina: o que decide as colunas do cupom. 48 colunas
                         numa bobina de 58 mm saem CORTADAS — e cortadas no fim da linha,
                         onde está o valor. Ver Impressao.Papel. -->
                    <TextBlock Text="Largura do papel do cupom" Style="{StaticResource Rotulo}"/>
                    <ComboBox x:Name="CboPapel" Margin="0,4,0,4" SelectionChanged="PapelMudou"/>
                    <TextBlock x:Name="TxtStatusPapel" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- 03/09 — pedido do dono: cada papel com TRÊS respostas, não com uma
                         caixinha de sim e não. "Perguntar na tela" é o estado que a
                         caixinha desmarcada já significava (não sai sozinho, o botão fica
                         à mão); "Não imprimir" é o estado novo, que antes não existia. -->
                    <TextBlock Text="Quando imprimir o cupom da venda" Style="{StaticResource Rotulo}"/>
                    <ComboBox x:Name="CboPolCupom" Margin="0,4,0,10"/>
                    <Button x:Name="BtnTesteImpressao" Content="Imprimir cupom de teste" Click="TestarImpressao"
                            Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtStatusImpressao" Foreground="{DynamicResource TextoFraco}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- COMANDA DO DELIVERY — configuração INDIVIDUAL (pedido do dono,
                         29/08): a comanda pode sair na bobina da expedição e o cupom na
                         do balcão. A regra de ouro do desenho está na caixinha
                         "Usar outra impressora": DESMARCADA por padrão, e desmarcada
                         significa "tudo na impressora do cupom, como sempre foi". Quem
                         instala um caixa não pode ser obrigado a escolher duas
                         impressoras — os campos só aparecem para quem tem duas. -->
                    <TextBlock Text="COMANDA DO DELIVERY: O PAPEL DA COZINHA" Foreground="{DynamicResource Marca}"
                               FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock Text="A comanda é o OUTRO papel: os itens e as observações do pedido, para quem produz. Não tem valor fiscal e não vai para o cliente."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Quando imprimir a comanda de delivery" Style="{StaticResource Rotulo}"/>
                    <ComboBox x:Name="CboPolComanda" Margin="0,4,0,4"/>
                    <TextBlock Text="Em Perguntar na tela a comanda sai pelo 🖨 de cada pedido, na tela Delivery."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkComandaSeparada" Content="Usar outra impressora só para a comanda da cozinha"
                              IsChecked="False" FontSize="14" Margin="0,0,0,4"
                              Checked="ComandaSeparadaMudou" Unchecked="ComandaSeparadaMudou"/>
                    <TextBlock x:Name="TxtComandaJunto"
                               Text="Desmarcado, a comanda sai na mesma impressora e na mesma bobina do cupom, que é o que este caixa já faz hoje."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,8"/>

                    <StackPanel x:Name="BlocoComandaSeparada" Visibility="Collapsed" Margin="24,2,0,8">
                        <TextBlock Text="Impressora da comanda da cozinha" Style="{StaticResource Rotulo}"/>
                        <ComboBox x:Name="CboImpressoraComanda" Margin="0,4,0,10"/>
                        <!-- Largura PRÓPRIA: a bobina da expedição costuma ser 58 mm e a do
                             balcão 80 mm. Antes desta linha a comanda usava a largura do
                             cupom e saía cortada no fim da linha, onde fica a quantidade. -->
                        <TextBlock Text="Largura do papel da comanda" Style="{StaticResource Rotulo}"/>
                        <ComboBox x:Name="CboPapelComanda" Margin="0,4,0,4" SelectionChanged="PapelComandaMudou"/>
                        <TextBlock x:Name="TxtStatusPapelComanda" Foreground="{DynamicResource TextoFraco}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                    </StackPanel>

                    <!-- O teste fica FORA do bloco escondido de propósito: ele imprime na
                         impressora que a comanda vai usar de verdade (separada ou não), e
                         é o único jeito de o dono saber que acertou antes do 1º pedido. -->
                    <Button x:Name="BtnTesteComanda" Content="Imprimir comanda de exemplo" Click="TestarComanda"
                            Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtStatusComanda"
                               Text="Isto também se troca na tela Delivery, no botão 🖨 do cabeçalho: é lá que a cozinha procura. E cada pedido tem o seu 🖨 para reimprimir a comanda."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- COMPROVANTE DO CARTÃO — as duas vias, separadas (pedido do dono,
                         03/09). Antes era UMA caixinha para as duas, e ela morava no passo
                         da maquininha. Aqui é onde quem instala procura: é escolha de
                         PAPEL, e o papel sai na impressora do cupom. -->
                    <TextBlock Text="COMPROVANTE DO CARTÃO: AS DUAS VIAS" Foreground="{DynamicResource Marca}"
                               FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock Text="Vale para a maquininha ligada no caixa por cabo. As duas vias saem na impressora do cupom."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Via do cliente (cartão)" Style="{StaticResource Rotulo}"/>
                    <ComboBox x:Name="CboPolViaCliente" Margin="0,4,0,8"/>
                    <TextBlock Text="Via do estabelecimento (cartão)" Style="{StaticResource Rotulo}"/>
                    <ComboBox x:Name="CboPolViaLoja" Margin="0,4,0,4"/>
                    <TextBlock Text="Em Perguntar na tela a via não sai sozinha: tire no menu TEF, em Reimprimir o último comprovante."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- Tema mora aqui porque é a outra coisa desta MÁQUINA (a luz do
                         balcão, como a bobina), e porque grava na hora: não passa pelo
                         Salvar nem pelo pareamento. -->
                    <TextBlock Text="TEMA DA TELA" Foreground="{DynamicResource Marca}"
                               FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CboTema" Margin="0,0,0,6" SelectionChanged="TemaSelecionado">
                        <ComboBoxItem Content="Escuro (noturno)"/>
                        <ComboBoxItem Content="Claro (diurno)"/>
                        <ComboBoxItem Content="Automático por horário"/>
                    </ComboBox>
                    <StackPanel x:Name="BlocoJanelaTema" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
                        <TextBlock Text="Claro de" Style="{StaticResource Rotulo}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTemaDe" Width="110" Margin="8,0,0,0" Tag="06:00" LostFocus="JanelaTemaMudou"/>
                        <TextBlock Text="até" Style="{StaticResource Rotulo}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="TxtTemaAte" Width="110" Margin="8,0,0,0" Tag="18:00" LostFocus="JanelaTemaMudou"/>
                    </StackPanel>
                    <TextBlock Text="Vale para ESTA máquina, não para quem entra no caixa: quem decide é a luz do balcão. Muda na hora."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                </StackPanel>

                <!-- 4 · MAQUININHA ───────────────────────────────────────── -->
                <StackPanel x:Name="PassoMaquininha" Visibility="Collapsed">
                    <!-- Quatro cartões, SEM parágrafo embaixo: o parágrafo antigo dizia que
                         "Sem TEF" era "cartão registrado na mão", o que está errado — a
                         forma cartão continua existindo, o que muda é que a cobrança não
                         sai daqui. O que cada opção muda vive na linha do PRÓPRIO cartão:
                         "Venda no POS" e "ControlPay" são nomes de fornecedor e não dizem
                         nada sozinhos a quem instala o caixa. -->
                    <TextBlock Text="Escolha a maquininha deste caixa" Style="{StaticResource Rotulo}" Margin="0,0,0,2"/>
                    <TextBlock Text="Na dúvida, é a primeira: a maquininha comum, que fica na mão e não tem cabo para o computador. As outras três só servem se o caixa mandar o valor para ela sozinho."
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextoFraco}"/>
                    <UniformGrid Columns="2" Margin="0,0,-8,6">
                        <RadioButton x:Name="OpTefNenhum" GroupName="tef" Style="{StaticResource BotaoOpcao}"
                                     MinHeight="92" Checked="TefMudou">
                            <StackPanel>
                                <TextBlock Text="Maquininha avulsa" FontWeight="Bold" FontSize="17"/>
                                <TextBlock Text="A da mão, que não conversa com este computador. O cliente passa o cartão nela, o caixa registra que foi cartão e fecha a venda."
                                           FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextoFraco}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OpTefNuvem" GroupName="tef" Style="{StaticResource BotaoOpcao}"
                                     MinHeight="92" Checked="TefMudou">
                            <StackPanel>
                                <TextBlock Text="Cobrança pela internet" FontWeight="Bold" FontSize="17"/>
                                <TextBlock Text="O caixa manda o valor e ele acende sozinho na maquininha da conta. Ela precisa estar conectada."
                                           FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextoFraco}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OpTefPayGo" GroupName="tef" Style="{StaticResource BotaoOpcao}"
                                     MinHeight="92" Checked="TefMudou">
                            <StackPanel>
                                <TextBlock Text="PayGo (pinpad no cabo)" FontWeight="Bold" FontSize="17"/>
                                <TextBlock Text="A maquininha fica ligada NESTE computador por cabo, e quem fala com ela é o PayGo Windows."
                                           FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextoFraco}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OpTefControlPay" GroupName="tef" Style="{StaticResource BotaoOpcao}"
                                     MinHeight="92" Checked="TefMudou">
                            <StackPanel>
                                <TextBlock Text="ControlPay (pinpad no cabo)" FontWeight="Bold" FontSize="17"/>
                                <TextBlock Text="Mesmo pinpad do PayGo, mas a cobrança passa pelo portal ControlPay."
                                           FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextoFraco}"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <StackPanel x:Name="BlocoPayGo" Visibility="Collapsed">
                        <TextBlock Text="Pasta do PayGo (a mesma configurada no PayGo Windows)" Style="{StaticResource Rotulo}"/>
                        <TextBox x:Name="TxtPayGoPasta" Margin="0,4,0,8" Tag="C:\PAYGO" TextChanged="CampoMudou"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Registro de certificação (738)" Style="{StaticResource Rotulo}"/>
                                <TextBox x:Name="TxtPayGoRegistro" Margin="0,4,0,0" Tag="a PayGo fornece"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Razão social da automação (716)" Style="{StaticResource Rotulo}"/>
                                <TextBox x:Name="TxtPayGoEmpresa" Margin="0,4,0,0" Tag="AMERICAN DAY"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rede do cartão" Style="{StaticResource Rotulo}"/>
                                <ComboBox x:Name="CboPayGoRede" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Rede do PIX" Style="{StaticResource Rotulo}"/>
                                <ComboBox x:Name="CboPayGoRedePix" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="BtnTestarPayGo" Content="Testar a maquininha" Click="TestarPayGo"
                                Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16" Margin="0,0,0,4"/>
                    </StackPanel>

                    <StackPanel x:Name="BlocoControlPay" Visibility="Collapsed">
                        <TextBlock Text="O PayGo Windows desta máquina precisa estar ativado como terminal ControlPay: é ele que fala com a maquininha. O caixa manda a cobrança e acompanha até o cliente passar o cartão."
                                   Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Chave de integração (portal ControlPay → Integrações → Chaves de integração)" Style="{StaticResource Rotulo}"/>
                        <PasswordBox x:Name="PwdCpayChave" Margin="0,4,0,8" FontSize="18" Padding="12,10"
                                     Background="{DynamicResource Painel}" Foreground="{DynamicResource Texto}"
                                     BorderBrush="{DynamicResource Borda}" PasswordChanged="CampoMudouSenha"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ID do terminal" Style="{StaticResource Rotulo}"/>
                                <TextBox x:Name="TxtCpayTerminal" Margin="0,4,0,0" Tag="ex.: 6408" TextChanged="CampoMudou"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ID da pessoa" Style="{StaticResource Rotulo}"/>
                                <TextBox x:Name="TxtCpayPessoa" Margin="0,4,0,0" Tag="ex.: 12247" TextChanged="CampoMudou"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Senha técnica" Style="{StaticResource Rotulo}"/>
                                <PasswordBox x:Name="PwdCpaySenha" Margin="0,4,0,0" FontSize="18" Padding="12,10"
                                             Background="{DynamicResource Painel}" Foreground="{DynamicResource Texto}"
                                             BorderBrush="{DynamicResource Borda}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rede do cartão" Style="{StaticResource Rotulo}"/>
                                <ComboBox x:Name="CboCpayRede" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Rede do PIX" Style="{StaticResource Rotulo}"/>
                                <ComboBox x:Name="CboCpayRedePix" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <!-- Ambiente: DESLIGADO por padrão (a loja opera em produção, e o
                             caixa novo tem que nascer cobrando de verdade). Continua na
                             tela, e não como valor fixo, porque a homologação do ControlPay
                             roda no sandbox: sem este controle, a máquina que está em
                             sandbox não tem como sair — e a que está em produção não tem
                             como entrar — a não ser mexendo no banco à mão. O resumo do
                             fim repete o aviso; config invisível que muda o que acontece
                             com o dinheiro é armadilha. -->
                        <CheckBox x:Name="ChkCpaySandbox" IsChecked="False" FontSize="14" Margin="0,0,0,8"
                                  Content="Ambiente de TESTE (sandbox): nenhuma cobrança é de verdade"/>
                        <Button x:Name="BtnTestarCpay" Content="Testar conexão com a PayGo" Click="TestarControlPay"
                                Style="{StaticResource BotaoBase}" MinHeight="50" FontSize="16" Margin="0,0,0,4"/>
                    </StackPanel>

                    <StackPanel x:Name="BlocoTefNuvem" Visibility="Collapsed">
                        <TextBlock Text="Serial da maquininha" Style="{StaticResource Rotulo}"/>
                        <TextBox x:Name="TxtTefSerial" Margin="0,4,0,4"/>
                        <TextBlock Text="Em branco, a cobrança vai para a maquininha padrão da conta."
                                   Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    </StackPanel>

                    <StackPanel x:Name="BlocoTefOpcoes" Visibility="Collapsed" Margin="0,6,0,0">
                        <!-- A caixinha das vias saiu daqui: virou duas escolhas de três
                             estados no passo Impressora, uma por via. -->
                        <CheckBox x:Name="ChkTefParcelas" IsChecked="False" FontSize="14" Margin="0,0,0,8"
                                  Content="Perguntar as parcelas no crédito (desligado, todo crédito sai à vista)"/>
                        <CheckBox x:Name="ChkTefVoucher" IsChecked="False" FontSize="14" Margin="0,0,0,8"
                                  Content="Aceitar vale-refeição (Alelo, Sodexo, VR, Ticket) pela maquininha (mostra o botão Refeição na venda)"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatusTef" Foreground="{DynamicResource TextoFraco}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                </StackPanel>

                <!-- 5 · PAREAMENTO ───────────────────────────────────────── -->
                <StackPanel x:Name="PassoPareamento" Visibility="Collapsed">
                    <Button x:Name="BtnParear" Content="Parear com o painel (código de 6 dígitos)" Click="Parear"
                            Style="{StaticResource BotaoBase}" MinHeight="56" FontSize="16" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtStatusPareamento"
                               Text="É o pareamento que manda vendas e notas para o painel, e é ele que traz o CNPJ e a série certos. Sem parear, não dá para concluir."
                               Foreground="{DynamicResource TextoFraco}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock x:Name="TxtPrimeiroOperador" Text="ADMINISTRADOR DA LOJA (DONO)"
                               Foreground="{DynamicResource Marca}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel x:Name="BlocoOperador">
                        <TextBlock Text="Nome" Style="{StaticResource Rotulo}"/>
                        <TextBox x:Name="TxtOpNome" Margin="0,4,0,10" TextChanged="CampoMudou"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CPF (é o login dele no caixa)" Style="{StaticResource Rotulo}"/>
                                <TextBox x:Name="TxtOpCpf" Margin="0,4,0,0" MaxLength="14" TextChanged="CampoMudou"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Senha (4 a 6 dígitos)" Style="{StaticResource Rotulo}"/>
                                <TextBox x:Name="TxtOpPin" Margin="0,4,0,0" MaxLength="6" TextChanged="CampoMudou"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Este primeiro cadastro é o dono: ele pode tudo: autoriza sangria e cancelamento, e a senha dele passa a ser a senha desta tela."
                                   Foreground="{DynamicResource TextoFraco}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    </StackPanel>
                </StackPanel>

                <!-- FIM · RESUMO ─────────────────────────────────────────── -->
                <StackPanel x:Name="PassoResumo" Visibility="Collapsed">
                    <ItemsControl x:Name="ListaResumo">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Painel}" BorderBrush="{DynamicResource Borda}"
                                        BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titulo}" Foreground="{DynamicResource TextoFraco}" FontSize="12.5"/>
                                        <TextBlock x:Name="valor" Text="{Binding Valor}" Foreground="{DynamicResource Texto}"
                                                   FontSize="16" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Atenção não é erro: é o que a loja escolheu e precisa
                                         saber que escolheu (homologação, só recibo, sandbox). -->
                                    <DataTrigger Binding="{Binding Atencao}" Value="True">
                                        <Setter TargetName="valor" Property="Foreground" Value="{DynamicResource Amarelo}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ── RODAPÉ: O QUE BLOQUEIA + NAVEGAÇÃO ─────────────────────────── -->
        <Border Grid.Row="2" Background="{DynamicResource Painel}" BorderBrush="{DynamicResource Borda}"
                BorderThickness="0,1,0,0">
            <StackPanel Width="620" HorizontalAlignment="Center" Margin="0,12,0,14">
                <!-- Fica NA TELA, não num popup: motivo escondido é motivo que o
                     instalador descobre clicando. -->
                <TextBlock x:Name="TxtBloqueio" Foreground="{DynamicResource Amarelo}" FontSize="13.5"
                           TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtErro" Foreground="{DynamicResource Erro}" FontSize="14"
                           TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnSair" Content="Sair sem salvar" Click="Sair"
                            Style="{StaticResource BotaoBase}" MinHeight="52" FontSize="15" Padding="22,0"
                            Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button Grid.Column="1" x:Name="BtnVoltar" Content="Voltar" Click="Voltar"
                            Style="{StaticResource BotaoBase}" MinHeight="52" FontSize="15" Padding="22,0"/>
                    <Button Grid.Column="3" x:Name="BtnSalvar" Content="Salvar" Click="Salvar"
                            Style="{StaticResource BotaoBase}" MinHeight="52" FontSize="15" Padding="22,0"
                            Margin="0,0,8,0" Visibility="Collapsed"/>
                    <Button Grid.Column="4" x:Name="BtnAvancar" Content="Avançar" Click="Avancar"
                            Style="{StaticResource BotaoPrincipal}" MinHeight="52" MinWidth="200" Padding="26,0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
