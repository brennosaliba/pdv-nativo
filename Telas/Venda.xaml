<UserControl x:Class="Pdv.Telas.Venda"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Fundo}">
    <UserControl.Resources>
        <!-- Botão de texto puro: "Limpar tudo", atalhos. Não compete com os alvos de toque. -->
        <Style x:Key="BotaoTexto" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Raiz" SizeChanged="RaizRedimensionou">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- cabeçalho -->
            <RowDefinition Height="Auto"/>   <!-- faixa de categorias (só em tela estreita) -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ TOPO: quem está no caixa. Responsabilidade sobre dinheiro precisa ter cara. ══ -->
        <Border Grid.Row="0" x:Name="Cabecalho" Background="{DynamicResource BarraDegrade}" Padding="18,10"
                BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- DUAS COLUNAS, e a ordem de prioridade importa.
                     Antes este Grid não tinha ColumnDefinitions: os dois StackPanel
                     ocupavam a MESMA célula, um ancorado à esquerda e outro à direita.
                     Em tela estreita eles se sobrepunham — os botões eram pintados por
                     cima do nome do operador, e sobrava só um pedaço de texto espremido
                     entre "Sangria" e "Suprimento".
                     Com Auto na direita, os BOTÕES nunca encolhem: num caixa, a ação
                     vale mais que a decoração. Quem cede espaço é a identidade, e ela
                     corta com reticências em vez de vazar por baixo. -->
                <!-- 03/09 (Savassi, 1024x768): com Auto na direita o WrapPanel recebe
                     largura INFINITA e nunca quebra linha — a fila de botoes saia da
                     tela ("Impre..."), e a identidade, na coluna *, ficava com ZERO.
                     Invertido: a identidade e Auto (limitada por MaxWidth, corta com
                     reticencias) e os botoes ficam na coluna *, que e finita — em tela
                     estreita eles quebram em duas linhas em vez de sumir. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" x:Name="Identidade" Orientation="Horizontal" VerticalAlignment="Center"
                            ClipToBounds="True" MaxWidth="470" Margin="0,0,12,0">
                    <!-- Logo da loja quando houver arquivo; senão o nome dela. O mesmo
                         executável atende qualquer cliente: nada de marca fixa aqui. -->
                    <Image x:Name="ImgLogo" Height="34" Margin="0,0,4,0" Visibility="Collapsed"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TxtLoja" FontSize="20" FontWeight="Black" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Ciano}"/>
                    <Ellipse x:Name="PontoLogo" Width="7" Height="7" Fill="{DynamicResource Rosa}"
                             Margin="6,0,0,4" VerticalAlignment="Bottom"/>

                    <Border x:Name="Separador" Width="1" Background="{DynamicResource Borda}" Margin="20,4,20,4"/>

                    <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center"
                            Background="{DynamicResource AvatarDegrade}">
                        <TextBlock x:Name="TxtInicial" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SobreMarca}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtOperador" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Texto}"
                                   FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtSessao" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextoFraco}"
                                   FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1" x:Name="Botoes" Orientation="Horizontal" HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <!-- Sincronizar é ato EXPLÍCITO: o gerente mexe no painel, o caixa
                         aperta o botão. O PDV nunca fica esperando a nuvem para vender. -->
                    <Button x:Name="BtnSync" Click="Sincronizar" Style="{StaticResource BotaoBarra}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtIconeSync" Text="⟳" FontSize="17" FontWeight="Bold"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sincronizar" VerticalAlignment="Center"/>
                            <Border x:Name="ChipPendencia" CornerRadius="9" Padding="7,1,7,2" Margin="9,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="{DynamicResource ChipAlertaFundo}" BorderBrush="{DynamicResource ChipAlertaBorda}" BorderThickness="1">
                                <TextBlock x:Name="TxtPendencia" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource Amarelo}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <!-- Atualizar o caixa: mesmo lugar e mesma cara do Sincronizar, porque
                         é o mesmo gesto — o operador toca, o caixa vai buscar o que está
                         no servidor. O SELO com o número da versão é a metade que o dono
                         pediu ("tem atualização"): sem ele ninguém descobre que existe
                         versão nova, e um botão que ninguém aperta é o mesmo que não ter.
                         Ele acende sozinho: o caixa pergunta ao servidor a cada 6 h. -->
                    <Button x:Name="BtnAtualizar" Click="AtualizarOCaixa" Style="{StaticResource BotaoBarra}"
                            ToolTip="Trocar o programa deste caixa pela versão mais nova">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtIconeAtualizar" Text="⬆" FontSize="16" FontWeight="Bold"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Atualizar" VerticalAlignment="Center"/>
                            <Border x:Name="ChipVersaoNova" CornerRadius="9" Padding="7,1,7,2" Margin="9,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="{DynamicResource ChipAlertaFundo}" BorderBrush="{DynamicResource ChipAlertaBorda}" BorderThickness="1">
                                <TextBlock x:Name="TxtVersaoNova" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource Amarelo}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <!-- KDS do quiosque: o operador cobra aqui e produz olhando ali.
                         O contador é o chamariz — sem ele ninguém abre a tela. -->
                    <Button x:Name="BtnKds" Click="AbrirKds" Style="{StaticResource BotaoBarra}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛎" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Delivery" VerticalAlignment="Center"/>
                            <Border x:Name="BadgeKds" CornerRadius="9" Padding="7,1,7,2" Margin="8,0,0,0"
                                    Background="{DynamicResource Rosa}" Visibility="Collapsed"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBadgeKds" Text="0" Foreground="{DynamicResource SobreMarca}"
                                           FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Click="AbrirChat" Style="{StaticResource BotaoBarra}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Chat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Sangria" Style="{StaticResource BotaoBarra}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↓" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sangria" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Suprimento" Style="{StaticResource BotaoBarra}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↑" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Suprimento" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="FecharCaixa" Style="{StaticResource BotaoBarra}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Fechar caixa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="TrocarImpressora" Style="{StaticResource BotaoBarra}"
                            ToolTip="Mandar o cupom para outra impressora">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Impressora" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Diz "Cancelar venda", não "Cartão": cancelar a venda e a NFC-e NÃO
                         precisam de maquininha (quem cancela a nota é o agente fiscal local),
                         e um botão com nome de cartão escondia isso justamente de quem opera
                         com maquininha AVULSA — que era quem mais precisava achar. O estorno
                         do cartão e a reimpressão continuam aqui dentro, para quem tem TEF. -->
                    <Button x:Name="BtnCancelar" Click="MenuCancelamento" Style="{StaticResource BotaoBarra}"
                            ToolTip="Cancelar uma venda e a nota fiscal · estornar cartão/PIX · reimprimir comprovante">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↩" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cancelar venda" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Sair" Click="Sair" Style="{StaticResource BotaoBarra}"
                            Background="{DynamicResource RosaDegrade}" Foreground="{DynamicResource SobreMarca}"
                            BorderThickness="0" FontWeight="Bold" Margin="14,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 03/09 (Savassi, 1024x768): em tela estreita as categorias saem da coluna
             lateral e viram uma FAIXA no topo, com rolagem para o lado (dedo, roda do
             mouse ou as setas). O centro fica inteiro para os produtos. Decisão em
             AplicarLargura (Venda.xaml.cs). -->
        <Border Grid.Row="1" x:Name="FaixaCategorias" Visibility="Collapsed"
                Background="{DynamicResource FundoAfundado}" BorderBrush="{DynamicResource Borda}"
                BorderThickness="0,0,0,1" Padding="6,6,6,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="◀" Width="40" Height="56" MinHeight="56" FontSize="14" Padding="0"
                        Style="{StaticResource BotaoBase}" Click="FaixaEsquerda" ToolTip="Categorias anteriores"/>
                <ScrollViewer Grid.Column="1" x:Name="RolagemFaixa" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                              PreviewMouseWheel="FaixaRoda" Margin="4,0,4,0">
                    <StackPanel x:Name="ListaCategoriasTopo" Orientation="Horizontal"/>
                </ScrollViewer>
                <Button Grid.Column="2" Content="▶" Width="40" Height="56" MinHeight="56" FontSize="14" Padding="0"
                        Style="{StaticResource BotaoBase}" Click="FaixaDireita" ToolTip="Próximas categorias"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- LARGURA PROPORCIONAL, não fixa. Antes eram 272 e 404 PIXELS travados:
                     676 px presos nas laterais em qualquer tela. Num monitor pequeno
                     sobrava tão pouco para os produtos que só cabiam 2 por linha — e é
                     daí que vinha a rolagem sem fim, não do tamanho do cartão (a grade
                     já é responsiva, ~178 px por produto). Num monitor grande, o oposto:
                     as laterais não cresciam e o meio ficava esticado.
                     Os limites existem porque nem tudo é elástico: abaixo de ~188 px a
                     categoria não cabe em 3 colunas, e abaixo de ~300 px a comanda perde
                     o botão de finalizar. Acima do teto é só desperdício — espaço extra
                     tem que ir para o PRODUTO, que é o que o operador olha. -->
                <!-- 03/09 (1024 de largura): a comanda com MinWidth 300 engolia a tela
                     e sobrava 188 para as categorias, com 3 por linha e nome quebrado.
                     O dono pediu: centro = produtos (maior), direita = comanda + total
                     (menor). MinWidth 250 cabe TOTAL, cupom e os dois botoes. -->
                <ColumnDefinition x:Name="ColCategorias" Width="1*"   MinWidth="172" MaxWidth="272"/>  <!-- categorias (some em tela estreita) -->
                <ColumnDefinition x:Name="ColProdutos"   Width="3.8*"/>                                <!-- produtos  -->
                <ColumnDefinition x:Name="ColComanda"    Width="1.1*" MinWidth="300" MaxWidth="340"/>  <!-- comanda: 300 é o mínimo que cabe TOTAL, cupom, Limpar e Finalizar -->
            </Grid.ColumnDefinitions>

            <!-- ══ ESQUERDA: categorias ══ -->
            <Border Grid.Column="0" x:Name="ColunaCategorias" SizeChanged="CategoriasRedimensionou"
                    Background="{DynamicResource FundoAfundado}" BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="ListaCategorias" Margin="10,10,10,14" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 2 por linha ate 12 categorias; acima disso 3 por
                                     linha com card mini (rede SaaS chega a 20+) -->
                                <UniformGrid Columns="{Binding ColunasCategorias, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ══ MEIO: busca + grade de produtos ══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sem campo de busca: o caixa é touch, sem teclado físico. Teclado na
                     tela pra achar produto é mais lento que dois toques na categoria. -->
                <Grid Grid.Row="0" Margin="18,16,16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SeloCategoria" Width="34" Height="34" CornerRadius="17"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtIconeCategoria" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtCategoriaAberta" Foreground="{DynamicResource Texto}"
                                   FontSize="21" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtContagem" Foreground="{DynamicResource TextoFraco}"
                                   FontSize="13" Margin="11,4,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Grade x lista: quem decora o cardápio vende mais rápido na lista
                         (cabe o dobro de itens na tela); quem não decora precisa da foto. -->
                    <Border HorizontalAlignment="Right" CornerRadius="12" Padding="4"
                            Background="{DynamicResource PainelDegrade}" BorderBrush="{DynamicResource Borda}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnGrade" Content="▦" FontSize="17" Width="48" Height="42" MinHeight="42"
                                    Style="{StaticResource BotaoBase}" Click="VerEmGrade" ToolTip="Ver em grade"/>
                            <Button x:Name="BtnLista" Content="☰" FontSize="17" Width="48" Height="42" MinHeight="42"
                                    Margin="4,0,0,0" Style="{StaticResource BotaoBase}" Click="VerEmLista" ToolTip="Ver em lista"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="RolagemProdutos" VerticalScrollBarVisibility="Auto"
                              Padding="10,0,10,10" SizeChanged="GradeRedimensionou">
                    <!-- Top é obrigatório: sem ele o ScrollViewer entrega a altura toda da
                         viewport e o UniformGrid divide igual entre as linhas — 2 linhas
                         ficam com meia tela cada e os cartões boiam, 3 linhas ficam justas.
                         Ancorado no topo, toda linha vale a altura de um cartão. -->
                    <ItemsControl x:Name="ListaProdutos" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Colunas calculadas pela largura real: com número fixo sobrava
                                     um vão morto à direita e os cartões ficavam grudados. -->
                                <UniformGrid Columns="{Binding Colunas, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="TxtSemProduto" Grid.Row="1" Visibility="Collapsed"
                           Text="Nada nesta categoria. Toque em Sincronizar para baixar o cardápio."
                           Foreground="{DynamicResource TextoFraco}" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="360" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- ══ DIREITA: a conta ══ -->
            <Border Grid.Column="2" Background="{DynamicResource FundoAfundado}" BorderBrush="{DynamicResource Borda}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,16,18,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Comanda" Foreground="{DynamicResource Texto}" FontSize="20" FontWeight="Bold"/>
                            <Border x:Name="ChipItens" CornerRadius="9" Padding="9,2,9,3" Margin="10,2,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="{DynamicResource ChipInfoFundo}" BorderBrush="{DynamicResource ChipInfoBorda}" BorderThickness="1">
                                <TextBlock x:Name="TxtQtdItens" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Ciano}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" x:Name="ScrollComanda" VerticalScrollBarVisibility="Auto" Padding="12,0,12,0">
                        <ItemsControl x:Name="ListaComanda"/>
                    </ScrollViewer>

                    <StackPanel x:Name="PainelVazio" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="104" Height="104" CornerRadius="26" BorderThickness="2"
                                HorizontalAlignment="Center" Background="{DynamicResource VeuElevado}"
                                BorderBrush="{DynamicResource CianoFraco}">
                            <TextBlock Text="🛍" FontSize="40" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Toque num produto" Foreground="{DynamicResource Ciano}" FontSize="17"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        <TextBlock Text="para começar a venda" Foreground="{DynamicResource TextoFraco}" FontSize="14"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{DynamicResource BarraDegrade}" BorderBrush="{DynamicResource Borda}"
                            BorderThickness="0,1,0,0" Padding="18,16,18,18">
                        <StackPanel>
                            <!-- Cortesia aplicada: cupom de erro de pedido resgatado no caixa.
                                 Some quando não há cortesia. O X remove. -->
                            <Border x:Name="CaixaCortesia" Visibility="Collapsed" CornerRadius="10"
                                    Background="{DynamicResource ChipOkFundo}" BorderBrush="{DynamicResource ChipOkBorda}" BorderThickness="1"
                                    Padding="12,8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCortesiaTitulo" Foreground="{DynamicResource Ok}"
                                                   FontSize="14" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtCortesiaItens" Foreground="{DynamicResource TextoFraco}"
                                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" Click="RemoverCortesia"
                                            Style="{StaticResource BotaoBase}" Width="42" Height="42" FontSize="16"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="TOTAL" Foreground="{DynamicResource TextoFraco}" FontSize="13"
                                           FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                                <TextBlock x:Name="TxtTotal" Text="R$ 0,00" Foreground="{DynamicResource Texto}"
                                           FontSize="42" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <!-- promoção de carrinho (03/09): a vencedora e o que não valeu junto -->
                            <TextBlock x:Name="TxtPromo" Visibility="Collapsed" Foreground="{DynamicResource Ok}"
                                       FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" Margin="0,-6,0,4"/>
                            <TextBlock x:Name="TxtPromoObs" Visibility="Collapsed" Foreground="{DynamicResource TextoFraco}"
                                       FontSize="12" HorizontalAlignment="Right" TextWrapping="Wrap"
                                       TextAlignment="Right" Margin="0,0,0,6"/>

                            <Button x:Name="BtnCortesia" Click="AplicarCortesia" Style="{StaticResource BotaoBase}"
                                    MinHeight="46" Margin="0,0,0,10" IsEnabled="False" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎁" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Aplicar cupom de cortesia" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnLimpar" Click="LimparComanda"
                                        Style="{StaticResource BotaoBase}" MinHeight="62" Margin="0,0,10,0" Padding="18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗑" FontSize="15" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Erro}"/>
                                        <TextBlock Text="Limpar" FontSize="16" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" x:Name="BtnFinalizar" Click="Finalizar"
                                        Style="{StaticResource BotaoPrincipal}" MinHeight="62" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Finalizar" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="→" FontSize="21" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Pagamento entra POR CIMA de tudo, cobrindo as três colunas e o rodapé:
             com o cliente pagando, nada mais na tela pode ser tocado por acidente. -->
        <ContentControl x:Name="PainelPagamento" Grid.Row="0" Grid.RowSpan="3"
                        Visibility="Collapsed" Panel.ZIndex="10"/>

        <!-- ══ RODAPÉ: estado do caixa. Offline muda o regime fiscal (contingência),
             então o operador precisa ver isso sem abrir menu nenhum. ══ -->
        <Border Grid.Row="3" Background="{DynamicResource BarraDegrade}" Padding="16,7"
                BorderBrush="{DynamicResource Borda}" BorderThickness="0,1,0,0">
            <Grid>
                <Border x:Name="ChipRede" CornerRadius="11" Padding="11,4,13,5" HorizontalAlignment="Left"
                        Background="{DynamicResource ChipOkFundo}" BorderBrush="{DynamicResource ChipOkBorda}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LuzRede" Width="9" Height="9" Fill="{DynamicResource Ok}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRede" Text="ONLINE" Foreground="{DynamicResource Ok}"
                                   FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="TxtRodape" Foreground="{DynamicResource TextoFraco}" FontSize="11.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Atalho do turno: a loja muda de luz às 18h e ninguém vai abrir
                         configuração no meio da fila. Texto puro, sem competir com os
                         alvos de toque da barra de cima. -->
                    <!-- Configuração também aqui: antes ela só existia no rodapé do login,
                         e para trocar uma impressora ou mexer no TEF o operador tinha que
                         sair do caixa. Continua pedindo a senha de administrador. -->
                    <Button x:Name="BtnConfigRodape" Style="{StaticResource BotaoTexto}" Click="AbrirConfiguracao"
                            Padding="6,2" Margin="0,0,16,0" Content="⚙ configuração"/>
                    <Button x:Name="BtnTema" Style="{StaticResource BotaoTexto}" Click="AlternarTema"
                            Padding="6,2" Margin="0,0,16,0" Content="☀ modo claro"/>
                    <TextBlock x:Name="TxtRelogio" Foreground="{DynamicResource TextoFraco}" FontSize="11.5"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Aviso de pedido novo do delivery: aparece por cima, com som. Um toque
             abre o quadro. Some sozinho em 60 s — o badge do botão continua. -->
        <Border x:Name="ToastKds" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,14,0"
                Background="{DynamicResource PainelDegrade}" BorderBrush="{DynamicResource Rosa}"
                BorderThickness="2" CornerRadius="14" Cursor="Hand" Panel.ZIndex="99"
                MouseLeftButtonUp="AbrirKdsPeloToast">
            <StackPanel Orientation="Horizontal" Margin="16,10,18,12">
                <TextBlock Text="🛎" FontSize="22" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtToastKds" Foreground="{DynamicResource Texto}"
                               FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="toque para abrir" Foreground="{DynamicResource TextoFraco}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
