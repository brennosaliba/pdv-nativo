<UserControl x:Class="Pdv.Telas.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Fundo}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">

            <TextBlock Text="PDV" FontSize="46" FontWeight="Bold"
                       Foreground="{DynamicResource Marca}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtLoja" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" Margin="0,2,0,26"/>

            <TextBlock x:Name="TxtEtapa" Text="Encoste o dedo no leitor" Style="{StaticResource Rotulo}" HorizontalAlignment="Center"/>

            <TextBlock x:Name="TxtErro" Text="" Foreground="{DynamicResource Erro}" FontSize="15"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       MinHeight="24" Margin="0,6,0,10"/>

            <!-- 1.0.54: so digital. Sem teclado e sem senha: o botao reabre a leitura (ou, com a
                 biometria desligada no painel, pede o codigo do gerente). -->
            <Button x:Name="BtnDigital" Style="{StaticResource BotaoPrincipal}" Content="Encoste o dedo no leitor"
                    Margin="5,14,5,0" Click="LerDigital"/>
        </StackPanel>

        <!-- Configuracao fica no rodape, discreta e protegida pela senha do usuario master da
             rede (nao e operador de turno): o operador nao deve nem pensar em mexer nisso. -->
        <Button x:Name="BtnConfig" Content="Configuração" Click="AbrirConfig"
                Style="{StaticResource BotaoBase}" MinHeight="40" FontSize="13"
                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextoFraco}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,10"/>
    </Grid>
</UserControl>
